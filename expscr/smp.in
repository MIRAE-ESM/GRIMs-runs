#!/bin/sh
set -ax
#
# ---------------  single column model program -------------------------------
#
# you may change the otuput intervals, but mostly not necessary 
# ceop data will be available in future
# output can be plotted using the grads control files in 
# RUNNAME/subA directory. grads shell scripts are in /post/plot directory.
#
#    Program history :
#
#    2015-01-19 young-hwa byun  initial development
#    2008-08-19 kyung-hee seol  nudging options, lsm options
#    2010-03-19 song-you hong   clean up, grims setup
#    2015-09-03 myung-seo koo   dimension allocatable
#    2019-09-19 myung-seo koo   dynamic run not depending configure-run
#
#-----------------------------------------------------------------------------
#
# select from arms18/arms38/gate19/toga40/trmm37
#             usgp37/mana45/mc3e42/peca41/iop142/iop242 for dcp
#
obs_smp=${scase:="usgp37"}
levs=64   # 0 for default level if sigma coordinate
#
if [ $# -eq 1 ]; then
	obs_smp=$1
fi
if [ "$obs_smp" -ne "arms18" -o "$obs_smp" -ne "arms38" -o \
	 "$obs_smp" -ne "gate19" -o "$obs_smp" -ne "toga40" -o \
	 "$obs_smp" -ne "trmm37" -o "$obs_smp" -ne "usgp37" -o \
	 "$obs_smp" -ne "mana45" -o "$obs_smp" -ne "mc3e42" -o \
	 "$obs_smp" -ne "peca41" -o "$obs_smp" -ne "iop142" -o \
	 "$obs_smp" -ne "iop242" ]; then
	echo "obs_smp should be arms18/arms38/gate19/toga40/trmm37/usgp37/mana45/mc3e42/peca41/iop142/iop242"
	exit 8
fi
#
# site for ceop64
#
site='KOREAN'
#
# Intervals of sigma output, sfc output and flx output
#
INTSFCX=24
INTOMLX=24
if [ $obs_smp = usgp37 -o $obs_smp = mana45 -o $obs_smp = peca41 -o \
	$obs_smp = iop142 -o $obs_smp = iop242 -o $obs_smp = mc3e42 ] ; then
INTSFC=1
INTSIG=1
INTFLX=1
INTNCO=1
else
INTSFC=3
INTSIG=3
INTFLX=3
INTNCO=3
fi
SWHR_GBL=1
LWHR_GBL=1
export SWHR_GBL LWHR_GBL
#
INITIAL_SFC_DIR=@SMPCON_DIR@/ncep_sfc
#
if [ $obs_smp = usgp37 ]; then
	SYEAR=2004 # 2004~2015 (125*15)
	subs=1; sube=125 
elif [ $obs_smp = mana45 ]; then
	SYEAR=2014 # 2014/2015
	subs=1; sube=361
elif [ $obs_smp = iop142 -o $obs_smp = iop242 ]; then
	subs=1; sube=36
elif [ $obs_smp = mc3e42 ]; then
	subs=1; sube=42
elif [ $obs_smp = peca41 ]; then
	subs=1; sube=41
else
	subs=1; sube=1
fi
sub=$subs
while [ $sub -le $sube ]; do
	if [ $sub -eq 1 ]; then
		exp=A
	fi
	if [ $obs_smp = toga40 ]; then
		SYYYYMMDDHH=1992122000
		EYYYYMMDDHH=1992122600
	elif [ $obs_smp = trmm37 ]; then
		SYYYYMMDDHH=1999081000
		EYYYYMMDDHH=1999082000
	elif [ $obs_smp = gate19 ]; then
		SYYYYMMDDHH=1974083000
		EYYYYMMDDHH=1974091903
	elif [ $obs_smp = arms38 ]; then
		SYYYYMMDDHH=2000030118
		EYYYYMMDDHH=2000032209
	elif [ $obs_smp = arms18 ]; then
		if [ $sub = 1 ]; then
			SYYYYMMDDHH=1997062700
			EYYYYMMDDHH=1997071800
			exp=A
		elif [ $sub = 2 ]; then
			SYYYYMMDDHH=1997070800
			EYYYYMMDDHH=1997071300
			exp=B
		elif [ $sub = 3 ]; then
			SYYYYMMDDHH=1997071300
			EYYYYMMDDHH=1997071800
			exp=C
		fi
	elif [ $obs_smp = usgp37 ]; then
		sname="sgp"
		IYYYYMMDDHH=${SYEAR}042800
		fhour=`echo "($sub-1)%125*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -gt 125 -a $fhour -eq 0 ]; then
			SYEAR=`echo $SYYYYMMDDHH | cut -c1-4`	
			SYEAR=`expr $Y4 + 1`
			SYYYYMMDDHH=${SYEAR}042800
		fi
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
        DCP_DIR='/home/mskoo/project/DCP/original_varanal'
	elif [ $obs_smp = mana45 ]; then
		sname="goamazon$SYEAR"
		IYYYYMMDDHH=${SYEAR}010100
		fhour=`echo "($sub-1)*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
        DCP_DIR='/home/mskoo/project/DCP/4.1.2'
	elif [ $obs_smp = mc3e42 ]; then
		sname="mc3e"
#		SYYYYMMDDHH=2011042200
		IYYYYMMDDHH=2011042200
		fhour=`echo "scale=5;($sub-1)*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
		DCP_DIR='/home/mskoo/project/DCP/4.2.1'
	elif [ $obs_smp = peca41 ]; then
		sname="pecan"
#		SYYYYMMDDHH=2015060100
		IYYYYMMDDHH=2015060100
		fhour=`echo "scale=5;($sub-1)*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
		DCP_DIR='/home/mskoo/project/DCP/4.2.1'
	elif [ $obs_smp = iop142 ]; then
		sname="goamazonIOP1"
#		SYYYYMMDDHH=2014021500
		IYYYYMMDDHH=2014021500
		fhour=`echo "scale=5;($sub-1)*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
		DCP_DIR='/home/mskoo/project/DCP/4.2.2/arm-iop/0eval-data/xie/scm-forcing/iop_at_mao/GOAMAZON/IOP1_v1.2'
	elif [ $obs_smp = iop242 ]; then
		sname="goamazonIOP2"
#		SYYYYMMDDHH=2014090100
		IYYYYMMDDHH=2014090100
		fhour=`echo "scale=5;($sub-1)*24;" | bc`
		SYYYYMMDDHH=`validate.s $IYYYYMMDDHH $fhour`
		if [ $sub -eq $sube ]; then
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 120`
		else
			EYYYYMMDDHH=`validate.s $SYYYYMMDDHH 123`
		fi
		YEAR=`echo $SYYYYMMDDHH | cut -c 1-4`
		MM=`echo $SYYYYMMDDHH | cut -c 5-6`
        INITIAL_SFC_DIR=/home/mskoo/GRIMs/grimsini/ra2/sfc/$YEAR/$MM
		DCP_DIR='/home/mskoo/project/DCP/4.2.2/arm-iop/0eval-data/xie/scm-forcing/iop_at_mao/GOAMAZON/IOP2_v1.2'
	elif [ $obs_smp = ceop64 ]; then
		if [ $site = BERMS ]; then
			SYYYYMMDDHH=2003070500
			EYYYYMMDDHH=2003080100
		elif [ $site = TIBET ]; then
			SYYYYMMDDHH=2003060200
			EYYYYMMDDHH=2003062900
		elif [ $site = KOREAN -o $sub = HIMALAYAS ]; then
			SYYYYMMDDHH=2003010100
			EYYYYMMDDHH=2003020200
		else
			SYYYYMMDDHH=2003070100
			EYYYYMMDDHH=2003080100
		fi
		exp=A
	else
		echo "unknown SMP observation $obs_smp"
		exit 1
	fi
	#
	ENDHOUR=`@ETC_DIR@/maketim $EYYYYMMDDHH -d $SYYYYMMDDHH`
	INCHOUR=$ENDHOUR
	#
	YYYYS=`echo $SYYYYMMDDHH | cut -c 1-4`
	MMS=`echo $SYYYYMMDDHH | cut -c 5-6`
	DDS=`echo $SYYYYMMDDHH | cut -c 7-8`
	HHS=`echo $SYYYYMMDDHH | cut -c 9-10`
	#
	YYYYE=`echo $EYYYYMMDDHH | cut -c 1-4`
	MME=`echo $EYYYYMMDDHH | cut -c 5-6`
	DDE=`echo $EYYYYMMDDHH | cut -c 7-8`
	HHE=`echo $EYYYYMMDDHH | cut -c 9-10`
	#
	# If you wish, you may modify EXECDIR to /tmp directory and keep these
	# scripts on your permanent disk.
	#
	if [ $obs_smp = usgp37 -o $obs_smp = mana45 -o \
	     $obs_smp = mc3e42 -o $obs_smp = peca41 -o \
		 $obs_smp = iop142 -o $obs_smp = iop242 ]; then
		EXECDIR=@OUTPUT_DIR@/$sname/$SYYYYMMDDHH
	else
		EXECDIR=@OUTPUT_DIR@/$obs_smp/sub$exp
	fi
	mkdir -p $EXECDIR 2>/dev/null
	#
	# namelist
	#
	. @RUNSCR_DIR@/namelist $EXECDIR || exit 8
	#
	# -------------  do not change below  -------------------------------------
	#
	#  blank means use guess (in the sfc file).
	#
#	SST_ANL_T0=/data/DATABASE/SST/OISST/gisst22.${YYYYS}.daily
	SST_ANL_T0=@CON_DIR@/gisst22.${YYYYS}.daily
	if [ ! -s $SST_ANL_T0 ]; then
	SST_ANL_T0=@CON_DIR@/clim.sst.grib
	fi
	ICE_ANL_T0=@CON_DIR@/clim.ice.r2.1979-1998.grib
	SNO_ANL_T0=@CON_DIR@/clim.snow.r2.1979-1998.grib
	SCV_ANL_T0=
	iicegrb0=1                      # 0 : use guess, 1 : use grib file
	isnogrb0=0
	isstgrb0=1
	ism2grb0=0
	SST_ANL=$SST_ANL_T0
	ICE_ANL=$ICE_ANL_T0
	SNO_ANL=$SNO_ANL_T0
	SCV_ANL=
	iicegrb=$iicegrb0
	isnogrb=$isnogrb0
	isstgrb=$isstgrb0
	ism2grb=$ism2grb0
	#
	scrnam=`echo $0 | sed 's?.*/??g'`
	cp $0 $EXECDIR/0LOG.$scrnam
	cp @SRCS_DIR@/define.h $EXECDIR/0LOG.define.h
	ls -l @BIN_DIR@ >$EXECDIR/0LOG.bindates
	#
	cd $EXECDIR
	if [ $? -ne 0 ] ; then
		echo "cd to $EXECDIR failed"
		exit 8
	fi
	#
	# Initial & BDY conditions
	#
	if [ $obs_smp = toga40 ]; then
		cp @SMPCON_DIR@/TOGA/9211/_dat/basic_flds.ifa_v2.1 $EXECDIR/.	       || exit 8
		cp @SMPCON_DIR@/TOGA/9211/_dat/deriv_flds.ifa_v2.1 $EXECDIR/.	       || exit 8
		cp @SMPCON_DIR@/TOGA/9211/_dat/lsf_flds.ifa_v2.1 $EXECDIR/.		       || exit 8
		cp @SMPCON_DIR@/TOGA/9211/_dat/misc_flds.ifa_v2.1 $EXECDIR/.		   || exit 8
	elif [ $obs_smp = trmm37 ]; then
		cp @SMPCON_DIR@/TRMM/9907/surface_kwjx.dat $EXECDIR/.			       || exit 8
		cp @SMPCON_DIR@/TRMM/9907/layer_kwjx.dat $EXECDIR/.					   || exit 8
	elif [ $obs_smp = arms38 ]; then
		cp @SMPCON_DIR@/ARM/0003/surface_0003.dat $EXECDIR/.			       || exit 8
		cp @SMPCON_DIR@/ARM/0003/layer_0003.dat $EXECDIR/.			           || exit 8
	elif [ $obs_smp = arms18 ]; then
		cp @SMPCON_DIR@/ARM/9707/source/zhang_v2/surface_9707v2.dat $EXECDIR/. || exit 8
		cp @SMPCON_DIR@/ARM/9707/source/zhang_v2/layer_9707v2.dat $EXECDIR/.   || exit 8
		cp @SMPCON_DIR@/ARM/9707/drv/jul97_arm_version2/jul97_zhang_advt_timescale_in.dat $EXECDIR/rlx_advtscl.dat	|| exit 8
	elif [ $obs_smp = usgp37 -o $obs_smp = mana45 -o \
	       $obs_smp = mc3e42 -o $obs_smp = peca41 -o \
		   $obs_smp = iop142 -o $obs_smp = iop242 ]; then
cat > $EXECDIR/namelist.smp << EOF
&smplist
idir='$DCP_DIR',
/
EOF
	elif [ $obs_smp = ceop64 ]; then
		cp @SMPCON_DIR@/CEOP/basic/obs.sig $EXECDIR/obs.sig                    || exit 8
#		cp /disk6/skh/SCM/obs/CEOP/$site/_out/${site}__MOLTS.dat $EXECDIR/molts.dat           || exit 8
#		cp /disk6/skh/SCM/obs/CEOP/$site/_out/${site}_${yymm}_sfc.dat $EXECDIR/sfc.dat        || exit 8
#		if [ $site != BERMS ]; then
#			cp /disk6/skh/SCM/obs/CEOP/$site/_out/${site}_${yymm}_stm.dat $EXECDIR/stm.dat     || exit 8
#		fi
#		if [ $site != KOREAN -o $site != HIMALAYAS -o $site != THAILAND ]; then
#			cp /disk6/skh/SCM/obs/CEOP/$site/_out/${site}_${yymm}_flx.dat $EXECDIR/flx.dat     || exit 8
#		fi
	fi
	INITIAL_SFC=$INITIAL_SFC_DIR/sfc.anl.$YYYYS$MMS$DDS$HHS.ieee
	if [ ! -s $INITIAL_SFC ]; then
		INITIAL_SFC=/data/DATABASE/ANALYSIS/GFS/gfs_sig/$YYYYS/$MMS/gfs.$YYYYS$MMS$DDS$HHS/gfs.t00z.sfcanl
	fi
	ln -sf $INITIAL_SFC $EXECDIR/cnvrt_initial_sfc   || exit 8
#
	rm -f ERROR.out 2>/dev/null
	#
	# Forecast section
	#
	if [ -s sigit -a -s sigitdt -a -s sfci ];then
		#
		#  Restart
		#
		@ETC_DIR@/date sigit >date.out || exit 8
		read HH MM DD yyyy FH <date.out
		rm date.out                                                                 
		@ETC_DIR@/fhour sigit >out || exit 8
		read h <out
		h=`expr $h`
		echo hour in the sigit file = $h
		if [ $h -lt 10 ];then h=0$h;fi
		rm out
	else
		#
		# mountain
		# 
		if [ ! -s slmsk  -o ! -s oroggd -o ! -s mtnvar ] ; then
			@RUNSCR_DIR@/mtn || exit 8
		fi
		#
		# Initial start.
		#
		h=00
		#
		# Run presmp process for sigit
		#  
		@RUNSCR_DIR@/presmp $YYYYS$MMS$DDS$HHS $YYYYE$MME$DDE$HHE|| exit 8
		# 
		cp sigit sig.ft$h
		cp sigit sigitdt
		if [ $? -ne 0 ] ; then
			echo "`date` $0: cp sigit sig.ft$h failed" >>ERROR.out
			exit 8
		fi
		#
		# Run sfc process 
		#
		SST_GRB_T0=`eval echo $SST_ANL_T0`
		SNO_GRB_T0=`eval echo $SNO_ANL_T0`
		SCV_GRB_T0=`eval echo $SCV_ANL_T0`
		ICE_GRB_T0=`eval echo $ICE_ANL_T0`
		export SST_GRB_T0 SNO_GRB_T0 SCV_GRB_T0 ICE_GRB_T0
		export iicegrb0 isstgrb0 isnogrb0 ism2grb
		@RUNSCR_DIR@/sfc0 gsm cnvrt_initial_sfc  || exit 8
		# 
		cp sfci sfc.ft$h
		if [ $? -ne 0 ] ; then
			echo "`date` $0: cp sfci sfc.ft$h failed" >>ERROR.out
			exit 8
		fi
		#
		@ETC_DIR@/date sigit >date.out || exit 8
		read HH MM DD yyyy FH <date.out
		rm date.out
	fi
	#
	@RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX:$INTOMLX \
			$INTSIG:$INTSFC:$INTFLX:$INTNCO:$INTRESTART || exit 8
	#
	endhour=$ENDHOUR
	inchour=$INCHOUR
	#
	#  loop
	#
	xc=0
	while [ $h -lt $endhour ] ; do
		#
		hx=`expr $h + $inchour`
		if [ $hx -gt $endhour ] ; then
			hx=$endhour
		fi
		if [ $hx -lt 10 ];then hx=0$hx;fi
		#
		#  Execute SFC program to update surface fields
		#
#  		modh=$h
#		if [ $modh -eq $h ] ; then 
#			@ETC_DIR@/date sigitdt >out || exit 8
#			read hour month day year fhour <out
#			rm out
#    		fhe=`expr $hx - $INTSFCX`
#       	hh=$h
#           if [ "$SFC0" = yes ] ; then
#              hhinc=$INTSFCX
#              if [ $INTSFCX -gt $INCHOUR ] ; then
#                 hhinc=$INCHOUR
#              fi
#              hh=`expr $h + $hhinc`
#              if [ $hh -lt 10 ] ; then
#                 hh=0$hh
#              fi
#           fi
#		fi
		#
		#  Execute forecast
		#
		@RUNSCR_DIR@/fcst || exit 8
		#
		#  pgb of the forecast
		#
		@RUNSCR_DIR@/pgb $h $hx $INTSIG || exit 8
		@RUNSCR_DIR@/fgb 0 $hx $INTFLX || exit 8
		#
		#  find archive files
		#
		#cp sig.ft$hx sigit
		#if [ $? -ne 0 ] ; then
		#	echo "`date` $0: cp sig.ft$hx sigit failed" >>ERROR.out
		#	exit 8
		#fi
		#mv sigp.ft$hx sigitdt  || exit 8
		#if [ $? -ne 0 ] ; then
		#	echo "`date` $0: mv sigp.ft$hx sigitdt failed" >>ERROR.out
		#	exit 8
		#fi
		#cp sfc.ft$hx sfci
		if [ $? -ne 0 ] ; then
			echo "`date` $0: cp sfc.ft$hx sfci failed" >>ERROR.out
			exit 8
		fi
		#
		#  rename fgb   pgb  dg3cld
		#
        if [ "$h" == "000" ]; then h = 00 ; fi
		YYYY=$YYYYS
		MM=$MMS
		DD=$DDS
		HH=$HHS
		hr_str=$h
		hr_end=$hx
		hr_stp=$hr_str
		while [ $hr_stp -le $hr_end ] ; do
			fdate=`@ETC_DIR@/validate.s $YYYY$MM$DD$HH $hr_stp`
			if [ $hr_stp -ne 00 -a $hr_stp -lt 10 ] ; then
				hr_stp=0$hr_stp
			fi
			mv fgb.ft$hr_stp fgb.$fdate
			@ETC_DIR@/force_grib_date_mon fgb.$fdate $fdate  || exit 8
			hr_stp=`expr $hr_stp + $INTFLX`
		done
		#
		hr_str=$h
		hr_end=$hx
		hr_stp=$hr_str
		while [ $hr_stp -le $hr_end ] ; do
			fdate=`@ETC_DIR@/validate.s $YYYY$MM$DD$HH $hr_stp`
			if [ $hr_stp -ne 00 -a $hr_stp -lt 10 ] ; then
				hr_stp=0$hr_stp
			fi
			mv pgb.ft$hr_stp pgb.$fdate
			@ETC_DIR@/force_grib_date_mon pgb.$fdate $fdate  || exit 8
			hr_stp=`expr $hr_stp + $INTSIG`
		done
		#
#		hr_str=$h
#		hr_end=$hx
#		hr_stp=$hr_str
#		while [ $hr_stp -le $hr_end ] ; do
#			fdate=`@ETC_DIR@/maketim $YYYY$MM$DD$HH -h $hr_stp`
#			if [ $hr_stp -ne 00 -a $hr_stp -lt 10 ] ; then
#				hr_stp=0$hr_stp
#			fi
#			mv dg3cld.ft$hr_stp dg3cld.$fdate
#			@ETC_DIR@/force_grib_date_mon dg3cld.$fdate $fdate  || exit 8
#			hr_stp=`expr $hr_stp + $INTSIG`
#		done
		#
		h=$hx
	done
	#
	# make control file for GrADs
	#
	@RUNSCR_DIR@/makectl pgb
	@RUNSCR_DIR@/makectl fgb
	@RUNSCR_DIR@/makectl dg3gb
	@RUNSCR_DIR@/makectl dcp
	@RUNSCR_DIR@/makectl cpsgb
	@RUNSCR_DIR@/makectl cpscld
	#	
	if [ -d @POST_DIR@/psmp ]; then
		for file in `/bin/ls @POST_DIR@/psmp/*.in | sed 's/\.in$//g'`; do
			sed "s%@EXEC_DIR@%$EXECDIR%g;s%@RUN_DIR@%@RUNS_DIR@%g" $file.in > $file
		done
	fi
	#
	sub=`expr $sub + 1`
done    # exp
