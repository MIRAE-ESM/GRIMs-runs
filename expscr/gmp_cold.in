#!/bin/sh 
set -ax
#
# ---------------  user changeable parameters ------------------------
#
# Change the following variable if you are running separate experiments
# from the same directory
#
RUNNAME=@RUNNAME@
if [ "$RUNNAME" = "" ]; then
  RUNNAME=p_000
fi
#
# Intervals of sfc execution, sigma output, sfc output and flx output
# Various options for running the model
#
INITIAL_DATE=2006070112 # Initial forecast date
SDATE=2006070112        # Starting forecast date
EDATE=2006080112        # Ending forecast date
INCSTRT=24
ENDHOUR=`expr 24 \* 5`  # Length of model integration in hour
INCHOUR=$ENDHOUR        # Forecast hour per one execution
INTSFCX=24              # Time interval to run surface merging
INTOMLX=24              # Time interval to run ocean mixed layer model
INTSIG=12               # Time interval to create sigma output file
INTSFC=12               # Time interval to create surface output file
INTFLX=12               # Time interval to create surface flux output file
INTNCO=12               # Time interavl to create nc output file
INTRESTART=$ENDHOUR     # Time interval to restart the model
SWHR_GBL=1              # Time interval of shortwave radiation flux (default=6)
LWHR_GBL=1              # Time interval of longwave  radiation flux
#
FCST_RESTART=yes        # Option indicating whether current forecast is first
#
SFC_WARM=yes            # Use the guess fields for sfc data
SFC_WARM_CYCLE=24       # Time interval of surface warm cycle
#
INPUT_PRESSURE=yes      # = yes for pressure grib file, = no for sigma file
#
ifecmwf=1               # for ecmwf data, = 0 for ncep grib data
ifmtngrb=1              # mtn data will be replaced by the grib file
#
FNMTNGRB=@INPUT_DIR@/ecmwf/orgd/Z_\$YYMMDDHH
#
if [ $INPUT_PRESSURE = yes ];then
	INITIAL_PRESSURE=@INPUT_DIR@/ecmwf/orgd/OD_OPER_AN_PL_\$YYYYMMDD
	if [ $ifecmwf = 1 ];then
		ifmoisrh=1  ### = 0 for sphm
		ifheight=0  ### = 0 for ECMWF data (m**2/s**2 : geopotential ), = 1 for height (m)  
		stdprs="1000.,925.,850.,700.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10.,7.,5.,3.,2.,1.,"
		iupd5=131
		ivpd5=132
		itpd5=130
		iqpd5=157
		izpd5=129
	else
		ifmoisrh=1  ### = 0 for sphm
		ifheight=1  ### = 0 for ECMWF data (m**2/s**2 : geopotential ), = 1 for height (m)  
		stdprs="1000.,850.,700.,600.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10.,"
		iupd5=33
		ivpd5=34
		itpd5=11
		iqpd5=52    ### =51 for sphm
		izpd5=7
	fi
	mkdir -p @PWD@/sig_sfc
	INITIAL_SIGMA=@PWD@/sig_sfc/sig.anl.\$YYYYMMDDHH
else
	INITIAL_SIGMA=@R2_DIR@/sig.anl.\$YYYYMMDDHH.ieee
fi
#
INITIAL_SFC=@R2_DIR@/sfc.anl.\$YYYYMMDDHH.ieee
INITIAL_SFC_FILE_TYPE=osu1
#
# ------------- below for expert user only -------------------------------------
#
# PUT THE INPUT FILES IN NFS DIRECTORY for MPI
#
SST_ANL_T0=@PWD@/../bdata/sst.grib
ICE_ANL_T0=@PWD@/../bdata/sea_ice.grib
SNO_ANL_T0=@CON_DIR@/clim.snow.r2.1979-1998.grib
SCV_ANL_T0=
#
iicegrb0=1                      # 0 : use guess, 1 : use grib file
isnogrb0=0
isstgrb0=1
ism2grb0=0
#
SST_ANL=@PWD@/../bdata/sst.grib
ICE_ANL=@PWD@/../bdata/sea_ice.grib
SNO_ANL=@CON_DIR@/clim.snow.r2.1979-1998.grib
SCV_ANL=
#
iicegrb=$iicegrb0
isnogrb=$isnogrb0
isstgrb=$isstgrb0
ism2grb=$ism2grb0
#
INPUT_RESOLUTION=t@IJCAP@k@ILEVS@
#
FCST_NPES=@NPES@
FCST_NCPUS=@NCPUS@
#
# If you wish, you may modify EXECDIR to /tmp directory and keep these
# scripts on your permanent disk.
#
YYYYMMDDHH=$SDATE
while [ $YYYYMMDDHH -le $EDATE ]; do
	EXECDIR=@OUTPUT_DIR@/$RUNNAME/$YYYYMMDDHH
	export EXECDIR
	mkdir -p $EXECDIR 2>/dev/null
	#
	#  cd to run directory
	#
	scrnam=`echo $0 | sed 's?.*/??g'`
	cp @PWD@/$0 $EXECDIR/0LOG.$scrnam
	cp @SRCS_DIR@/define.h $EXECDIR/0LOG.define.h
	ls -l @BIN_DIR@ >$EXECDIR/0LOG.bindates
	cd $EXECDIR || exit 8
	#
	#  renew log file
	#
	cat @PWD@/$0 > ERROR.out
	echo '==============' >>ERROR.out
	#
	# Automatic restart
	#
	if [ @BARO_TEST@ != 1 ]; then
		if [ -s sigit -a -s sigitdt -a -s sfci -a "$FCST_RESTART" = yes ];then
			#
			#  Restart
			#
			h=`@ETC_DIR@/fhour sigit`
			echo "fhour in the sigit file = $h"
		else
			#
			# mtn
			#
			if [ ! -s slmsk  -o ! -s oroggd -o ! -s mtnvar ] ; then
				@RUNSCR_DIR@/mtn || exit 8
			fi
			#
			#  Initial start.
			#
			h=00
			#
			# Conversion from ascii to native format
			#
			if [ $INPUT_PRESSURE = yes ];then
				sigma=dummy
				init_sig=dummy
			else
				sigma=`eval echo $INITIAL_SIGMA`
				init_sig=cnvrt_initial_sig
			fi
			#
			YYYY=`echo $YYYYMMDDHH | cut -c1-4`
			MM=`echo $YYYYMMDDHH | cut -c5-6`
			DD=`echo $YYYYMMDDHH | cut -c7-8`
			HH=`echo $YYYYMMDDHH | cut -c9-10`
			YYMMDDHH=`echo $YYYYMMDDHH | cut -c3-10`
			#
			if [ $YYYYMMDDHH = $INITIAL_DATE -o $SFC_WARM != yes ];then
				sfcf=`eval echo $INITIAL_SFC`
				fmt=`echo $sfcf | sed 's/.*\.//g'`
				@ETC_DIR@/scnvrt gsm $INITIAL_SFC_FILE_TYPE \
					@IJCAP@:@ILONF@:@ILATG@:@ILEVS@  -1:-1:-1:-1:-1 $fmt:bin \
					$sigma:$sfcf $init_sig:cnvrt_initial_sfc || exit 8
				#
				# Change input resolution to model resolution
				#
				@RUNSCR_DIR@/chgr $init_sig cnvrt_initial_sfc \
						sigit sfci $INITIAL_SFC_FILE_TYPE || exit 8
			else
				sfc_guess_date=`@ETC_DIR@/maketim $YYYYMMDDHH -$SFC_WARM_CYCLE`
				while [ ! -s ../$sfc_guess_date/sfc.ft$SFC_WARM_CYCLE ]; do
					sleep 120
				done
				cp ../$sfc_guess_date/sfc.ft$SFC_WARM_CYCLE sfc_guess  || exit 8
				cp ../$sfc_guess_date/sig.ft$SFC_WARM_CYCLE sig_guess  || exit 8
				@ETC_DIR@/date sfc_guess >date.$$ || exit 8
				read BHH BMM BDD BYYYY BFH <date.$$ ; rm date.$$
				sfc_guess_fcst=`@ETC_DIR@/validate.s $BYYYY$BMM$BDD$BHH $BFH`
				if [ $YYYYMMDDHH != $sfc_guess_fcst ]; then
					exit 8
				fi
				@RUNENV@ @RUNSCR_DIR@/chgdates $YYYY:$MM:$DD:$HH:0 \
								sig_guess:sfc_guess dummy:sfci || exit 8
				INITIAL_SFC_FILE_TYPE=`grep '^sfcftyp=' @RUNSCR_DIR@/../cvar.env | cut -d'=' -f2`
			fi
			#
			# Conversion from pressure-grib to sigma format
			#
			if [ $INPUT_PRESSURE = yes ];then
				YYYYMMDD=`echo $YYYYMMDDHH | cut -c1-8`
				prsgrb=`eval echo $INITIAL_PRESSURE`
				fnmtngrb=`eval echo $FNMTNGRB`
				sigma_pressure=`eval echo $INITIAL_SIGMA`
				@RUNSCR_DIR@/p2sig $prsgrb $sigma_pressure \
								${YYYYMMDDHH}00 $ifmoisrh $ifheight \
								$iupd5:$ivpd5:$itpd5:$iqpd5:$izpd5:$ifmtngrb $stdprs \
								sfci $fnmtngrb || exit 8
				cp $sigma_pressure sigit
				@ETC_DIR@/date $sigma_pressure >date.$$ || exit 8
				read HH MM DD yyyy FH <date.$$ ; rm date.$$
				echo $yyyy $MM $DD $HH $FH
			fi
			#
			#  convert initial sfc file type to model sfc file type
			#
			SST_GRB_T0=`eval echo $SST_ANL_T0`
			SNO_GRB_T0=`eval echo $SNO_ANL_T0`
			SCV_GRB_T0=`eval echo $SCV_ANL_T0`
			ICE_GRB_T0=`eval echo $ICE_ANL_T0`
			export SST_GRB_T0 SNO_GRB_T0 SCV_GRB_T0 ICE_GRB_T0
			export iicegrb0 isstgrb0 isnogrb0 ism2grb
			@RUNSCR_DIR@/sfc0 gsm sfci sfco $INITIAL_SFC_FILE_TYPE || exit 8
			#
			cp sfco sfci || exit 8
			cp sigit sigitdt  || exit 8
			cp sigit sig.ft$h || exit 8
			cp sfci  sfc.ft$h || exit 8
			#
			@ETC_DIR@/date sigit >date.$$ || exit 8
			read HH MM DD yyyy FH <date.$$ ; rm date.$$
			echo $yyyy $MM $DD $HH $FH
			#
			#  pgb of the initial
			#
			if [ @DOPOST@ = yes ] ; then
				@RUNSCR_DIR@/pgb $h $h $INTSIG || exit 8
			elif [ @CATPGB@ = yes ] ; then
				@ETC_DIR@/catpgb
			fi
		fi
	else  # baro test
		h=0
	fi
	#
	#  forecast hour loop
	#
	xc=0
	while [ $h -lt $ENDHOUR ] ; do
		#
		hx=`expr $h + $INCHOUR`
		if [ $hx -gt $ENDHOUR ] ; then
			hx=$ENDHOUR
		fi
		if [ $hx -lt 10 ];then hx=0$hx;fi
		#
		SST_GRB=`eval echo $SST_ANL`
		SNO_GRB=`eval echo $SNO_ANL`
		SCV_GRB=`eval echo $SCV_ANL`
		ICE_GRB=`eval echo $ICE_ANL`
		export SST_GRB SNO_GRB SCV_GRB ICE_GRB iicegrb isstgrb isnogrb ism2grb
		export SWHR_GBL LWHR_GBL
		@RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX:$INTOMLX \
					$INTSIG:$INTSFC:$INTFLX:$INTNCO:$INTRESTART || exit 8
		sleep 2     # wait for file writing done
		#
		#  Execute forecast
		#
    if [ "@BATCHQUE@" = qsub ]; then
        fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst @BATCHsuffix@`
        log_name="fcst.e`echo $fcstid | cut -d'.' -f1`"
    elif [ "@BATCHQUE@" = llsubmit ]; then
        fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst @BATCHsuffix@`
        log_name="fcst.e`echo $fcstid | cut -d'.' -f2`"
    elif [ "@BATCHQUE@" = bsub ]; then
        fcstid0=`@BATCHQUE@ < @RUNSCR_DIR@/fcst @BATCHsuffix@`
        fcstid="`echo $fcstid0  | cut -d'<' -f2 | cut -d'>' -f1`"
        log_name="fcst.e`echo $fcstid`"
    fi
		#
		#  Postprocess (pgb, fgb)
		#
		if [ @BARO_TEST@ != 1 ]; then
	        if [ @DOPOST@ = yes ] ; then
				phs=$h
				phe=$hx
				phinc=$INTSIG
				fhs=$h
				fhe=$hx
				fhinc=$INTFLX
				if [ $h -gt 0 ]; then
					phs=`expr $h + $INTSIG`
					fhs=`expr $h + $INTFLX`
				fi
				export phs phe phinc fhs fhe fhinc
				if [ "@BATCHQUE@" != "" ]; then
					if [ "@BATCHQUE@" = llsubmit ]; then
						@RUNSCR_DIR@/wait_que_job $fcstid $log_name @BATCHstatus@ || exit 8
						fcstid=""
					fi
                if [ "@BATCHQUE@" = bsub ]; then
                    pgbid=`@BATCHQUE@ @BATCHdepend@ "done(${fcstid})" \
                           < @RUNSCR_DIR@/pgb @BATCHsuffix@`
                    fgbid=`@BATCHQUE@ @BATCHdepend@ "done(${fcstid})" \
                           < @RUNSCR_DIR@/fgb @BATCHsuffix@`
                    if [ "$SIG_GRIB" = yes ]; then
                        sgbid=`@BATCHQUE@ @BATCHdepend@ "done(${fcstid})" \
                               < @RUNSCR_DIR@/sgb @BATCHsuffix@`
                    fi
                    pgbid="`echo $pgbid  | cut -d'<' -f2 | cut -d'>' -f1`"
                    fgbid="`echo $fgbid  | cut -d'<' -f2 | cut -d'>' -f1`"
                    sgbid="`echo $sgbid  | cut -d'<' -f2 | cut -d'>' -f1`"
				else
					@RUNSCR_DIR@/pgb $phs $phe $phinc  || exit 8
					@RUNSCR_DIR@/fgb $fhs $fhe $fhinc  || exit 8
				fi
			elif [ @CATPGB@ = yes ] ; then
  	          @ETC_DIR@/catpgb
			fi
		fi
		#
		#  wait for queue job of fgb
		#
        if [ "@BATCHQUE@" != "" ]; then
            @RUNSCR_DIR@/wait_que_job $fgbid $log_name @BATCHstatus@ || exit 8
        fi
		#
		h=$hx
	done
	YYYYMMDDHH=`@ETC_DIR@/maketim $YYYYMMDDHH $INCSTRT`
done
#
echo "`date` $0: Completely ended"
if [ @SYSTEM@ = mac -a @MARCH@ = mpi ] ; then
   lamclean
   lamhalt
fi
