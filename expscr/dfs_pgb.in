#!/bin/sh 
#PBS -l mppe=1
#
set -ax
#
if [ @SYSTEM@ = x1e ] ; then
        . /opt/modules/modules/init/sh
        module load open pbs PrgEnv
fi
#
# this script makes 72 hour integration starting from an example initial
# condition. ideal for first testing the system on new computer system
#
# ---------------  user changeable parameters ------------------------
#
# Change the following variable if you are running separate experiments
# from the same directory
#
RUNNAME=
#
# Intervals of sfc execution, sigma output, sfc output and flx output
# Various options for running the model
#
SDATE=2006070112
EDATE=2006070112
INCSTRT=24
ENDHOUR=`expr 24 \* 10`
ENDHOUR=`expr $ENDHOUR + 6`
INCHOUR=$ENDHOUR
INTSFCX=24
INTOMLX=24
INTSIG=12
INTSFC=12
INTFLX=12
INTRESTART=$ENDHOUR
SWHR_GBL=1			# interval of short wave radiation flux (default=6)
LWHR_GBL=3
#
fgb_post=1
#
FCST_RESTART=yes
#
INPUT_PRESSURE=yes
ifecmwf=1   # for ecmwf data, = 0 for ncep grib data
#
if [ $INPUT_PRESSURE = yes ];then
   INITIAL_PRESSURE=@INPUT_DIR@/ecmwf/orgd/OD_OPER_AN_PL_\$YYYYMMDD
   if [ $ifecmwf = 1 ];then
   ifmoisrh=1  ### = 0 for sphm
   ifheight=0  ### = 0 for ECMWF data (m**2/s**2 : geopotential ), = 1 for height (m)  
   stdprs="1000.,925.,850.,700.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10.,7.,5.,3.,2.,1.,"
   iupd5=131
   ivpd5=132
   itpd5=130
   iqpd5=157
   izpd5=129
   else
   ifmoisrh=1  ### = 0 for sphm
   ifheight=1  ### = 0 for ECMWF data (m**2/s**2 : geopotential ), = 1 for height (m)  
   stdprs="1000.,850.,700.,600.,500.,400.,300.,250.,200.,150.,100.,70.,50.,30.,20.,10.,"
   iupd5=33
   ivpd5=34
   itpd5=11
   iqpd5=52    ### =51 for sphm
   izpd5=7
   fi
   mkdir -p @PWD@/sig_sfc
   INITIAL_SIGMA=@PWD@/sig_sfc/sig.anl.\$YYYYMMDDHH
else
   INITIAL_SIGMA=@INPUT_DIR@/r2/sig_sfc/sig.anl.\$YYYYMMDDHH.ieee
fi
INITIAL_SFC=@INPUT_DIR@/r2/sig_sfc/sfc.anl.\$YYYYMMDDHH.ieee
INITIAL_SFC_FILE_TYPE=osu1
#
#  ------------- below for expert user only --------------------
#
# PUT THE INPUT FILES IN NFS DIRECTORY for MPI
#
SST_ANL_T0=@PWD@/../bdata/sst.grib
ICE_ANL_T0=@PWD@/../bdata/sea_ice.grib
SNO_ANL_T0=@CON_DIR@/clim.snow.r2.1979-1998.grib
SCV_ANL_T0=
iicegrb0=1                      # 0 : use guess, 1 : use grib file
isnogrb0=0
isstgrb0=1
ism2grb0=0
SST_ANL=@PWD@/../bdata/sst.grib
ICE_ANL=@PWD@/../bdata/sea_ice.grib
SNO_ANL=@CON_DIR@/clim.snow.r2.1979-1998.grib
SCV_ANL=
iicegrb=$iicegrb0
isnogrb=$isnogrb0
isstgrb=$isstgrb0
ism2grb=$ism2grb0
#
INPUT_RESOLUTION=t@IJCAP@k@ILEVS@
#
FCST_NPES=@NPES@
FCST_NCPUS=@NCPUS@
#
# set environmental variables
#
. @RUNSCR_DIR@/envset
#
# If you wish, you may modify EXECDIR to /tmp directory and keep these
# scripts on your permanent disk.
#
YYYYMMDDHH=$SDATE
while [ $YYYYMMDDHH -le $EDATE ]
do
   if [ -z $RUNNAME ]; then
	   EXECDIR=@PWD@/$YYYYMMDDHH
   else 
	   EXECDIR=@PWD@/$RUNNAME
   fi
   export EXECDIR
   mkdir -p $EXECDIR 2>/dev/null
   #
   #  cd to run directory
   #
   scrnam=`echo $0 | sed 's?.*/??g'`
   cp @PWD@/$0 $EXECDIR/0LOG.$scrnam
   cp @SRCS_DIR@/define.h $EXECDIR/0LOG.define.h
   ls -l @BIN_DIR@ >$EXECDIR/0LOG.bindates
   cd $EXECDIR || exit 8
   #
   #  renew log file
   #
   cat @PWD@/$0 > ERROR.out
   echo '==============' >>ERROR.out
   #
   # Automatic restart
   #
   if [ @BARO_TEST@ != 1 ]; then
   if [ -s sigit -a -s sigitdt -a -s sfci -a "$FCST_RESTART" = yes ];then
	   #
	   #  Restart
	   #
	   h=`@ETC_DIR@/fhour sigit`
	   echo "fhour in the sigit file = $h"
   else
	   #
	   #  Initial start.
	   #
	   h=00
	   #
	   # Conversion from pressure-grib to sigma format
	   #
      if [ $INPUT_PRESSURE = yes ];then
         YYYYMMDD=`echo $YYYYMMDDHH | cut -c1-8`
         prsgrb=`eval echo $INITIAL_PRESSURE`
         sigma_pressure=`eval echo $INITIAL_SIGMA`
         @RUNSCR_DIR@/p2sig $prsgrb $sigma_pressure \
                            ${YYYYMMDDHH}00 $ifmoisrh $ifheight \
                            $iupd5:$ivpd5:$itpd5:$iqpd5:$izpd5 $stdprs || exit 8
         sigma=dummy
         init_sig=dummy
         #
	      @ETC_DIR@/date $sigma_pressure >date.$$ || exit 8
	      read HH MM DD yyyy FH <date.$$ ; rm date.$$
	      echo $yyyy $MM $DD $HH $FH
      else
         sigma=`eval echo $INITIAL_SIGMA`
         init_sig=cnvrt_initial_sig
      fi
	   #
	   # Conversion from ascii to native format
	   #
      sfcf=`eval echo $INITIAL_SFC`
	   fmt=`echo $sfcf | sed 's/.*\.//g'`
	   @ETC_DIR@/scnvrt gsm $INITIAL_SFC_FILE_TYPE \
		   @IJCAP@:@ILONF@:@ILATG@:@ILEVS@ \
		   -1:-1:-1:-1:-1 \
		   $fmt:bin $sigma:$sfcf \
		   $init_sig:cnvrt_initial_sfc || exit 8
      if [ $INPUT_PRESSURE != yes ];then
         #
	      # Find initial date and hour
	      #
	      @ETC_DIR@/date $init_sig >date.$$ || exit 8
	      read HH MM DD yyyy FH <date.$$ ; rm date.$$
	      echo $yyyy $MM $DD $HH $FH
      fi
	   #
	   # Change input resolution to model resolution
	   #
	   @RUNSCR_DIR@/chgr \
			$init_sig cnvrt_initial_sfc \
			sigit sfci \
			$INITIAL_SFC_FILE_TYPE || exit 8
      if [ $INPUT_PRESSURE = yes ];then
         cp $sigma_pressure sigit
      fi
	   #
	   #  convert initial sfc file type to model sfc file type
	   #
	   SST_GRB_T0=`eval echo $SST_ANL_T0`
	   SNO_GRB_T0=`eval echo $SNO_ANL_T0`
	   SCV_GRB_T0=`eval echo $SCV_ANL_T0`
	   ICE_GRB_T0=`eval echo $ICE_ANL_T0`
	   export SST_GRB_T0 SNO_GRB_T0 SCV_GRB_T0 ICE_GRB_T0
      export iicegrb0 isstgrb0 isnogrb0 ism2grb
	   @RUNSCR_DIR@/sfc0 gsm sfci sfco $INITIAL_SFC_FILE_TYPE || exit 8
	   #
	   cp sfco sfci || exit 8
	   cp sigit sigitdt || exit 8
	   cp sigit sig.ft$h || exit 8
	   cp sfci  sfc.ft$h || exit 8
	   #
	   @ETC_DIR@/date sigit >date.$$ || exit 8
	   read HH MM DD yyyy FH <date.$$ ; rm date.$$
	   echo $yyyy $MM $DD $HH $FH
	   #
	   #  pgb of the initial
	   #
	   if [ @DOPOST@ = yes ] ; then
		   if [ "@BATCHJOB@" = "" ]; then
			   @RUNSCR_DIR@/pgb $h $h $INTSIG || exit 8
		   else
			   if [ @BATCHQUE@ = qsub ]; then
				   @BATCHJOB@ -v fhs=$h,fhe=$h,fhinc=$INTSIG \
					   @RUNSCR_DIR@/pgb
			   else
				   @BATCHJOB@  @RUNSCR_DIR@/pgb
			   fi
		   fi
	   elif [ @CATPGB@ = yes ] ; then
		   @ETC_DIR@/catpgb
	   fi
   fi
   else  # baro test
	   h=0
   fi
   #
   #  forecast hour loop
   #
   xc=0
   while [ $h -lt $ENDHOUR ] ; do
	   #
	   hx=`expr $h + $INCHOUR`
	   if [ $hx -gt $ENDHOUR ] ; then
		   hx=$ENDHOUR
	   fi
	   if [ $hx -lt 10 ];then hx=0$hx;fi
	   #
	   SST_GRB=`eval echo $SST_ANL`
	   SNO_GRB=`eval echo $SNO_ANL`
	   SCV_GRB=`eval echo $SCV_ANL`
	   ICE_GRB=`eval echo $ICE_ANL`
	   export SST_GRB SNO_GRB SCV_GRB ICE_GRB iicegrb isstgrb isnogrb ism2grb
	   export SWHR_GBL LWHR_GBL
	   @RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX:$INTOMLX \
			   $INTSIG:$INTSFC:$INTFLX:$INTRESTART || exit 8
	   #
	   #  Execute forecast
	   #
		if [ "$BATCHQUE" = qsub ]; then
   	     fcstid=`$BATCHQUE @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     log_name="fcst.e`echo $fcstid | cut -d'.' -f1`"
	    elif [ "$BATCHQUE" = llsubmit ]; then
   	     fcstid=`$BATCHQUE @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     log_name="fcst.e`echo $fcstid | cut -d'.' -f2`"
		elif [ "$BATCHQUE" = bsub ]; then
   	     fcstid0=`$BATCHQUE < @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     fcstid="`echo $fcstid0  | cut -d'<' -f2 | cut -d'>' -f1`"
   	     log_name="fcst.e`echo $fcstid`"
		fi
	   #
	   #  pgb of the forecast
	   #
	   if [ @BARO_TEST@ != 1 ]; then
	   if [ @DOPOST@ = yes ] ; then
		   if [ "@BATCHJOB@" = "" ]; then
			   @RUNSCR_DIR@/pgb $INTSIG $hx $INTSIG || exit 8
			   if [ $fgb_post -eq 1 ]; then
				   @RUNSCR_DIR@/fgb 0 $hx $INTFLX || exit 8
			   fi
		   else
			   if [ @BATCHQUE@ = qsub ]; then
				   @BATCHJOB@ -W depend=afterok:$fcstid -v fhs=$INTSIG,fhe=$hx,fhinc=$INTSIG \
					   @RUNSCR_DIR@/pgb
				   if [ $fgb_post -eq 1 ]; then
					   @BATCHJOB@ -W depend=afterok:$fcstid -v fhs=0,fhe=$hx,fhinc=$INTFLX \
						   @RUNSCR_DIR@/fgb
				   fi
			   else
				   # needs some modification (ex. ibm)
				   @BATCHJOB@  @RUNSCR_DIR@/pgb
				   if [ $fgb_post -eq 1 ]; then
					   @BATCHJOB@  @RUNSCR_DIR@/fgb
				   fi
			   fi
		   fi
	   elif [ @CATPGB@ = yes ] ; then
		   @ETC_DIR@/catpgb
	   fi
	   fi
	   #
	   #  wait for queue job
	   #
	   if [ "@BATCHQUE@" = qsub ]; then
		   @RUNSCR_DIR@/wait_que_job $lastid $log_name || exit 8
	   fi
      #
      h=$hx
   done
   YYYYMMDDHH=`@ETC_DIR@/maketim $YYYYMMDDHH $INCSTRT`
done
if [ @SYSTEM@ = mac -a @MARCH@ = mpi ] ; then
   lamclean
   lamhalt
fi
