#!/bin/sh
set -ax
#
#  This script makes ensemble hindcasts from GFS analysis.  
#  Monthly averages are computed and 
#  results are archived to given ftp site.
#
# ---------------  User changeable parameters  -------------------------
#
# run directory
#
RUNNAME=@RUNNAME@
if [ "$RUNNAME" = "" ]; then
	RUNNAME=gsim_out
fi
#
# Initial year, month, day, hour of the first ensemble member
#
YYYYSTART=2017   # starting initial year
YYYYEND=2017     # ending initial year ( not ending forecast year )
LENMON=3         # length of model integration in month
MMSS=05          # initial month [05(JJA), 11(DJF)]
DDSS=01          # initial day
HHSS=00          # initial hour
#
# Number of members in an ensemble
#
NENS=5 
#
# Ensemble initial condition time interval
#
INCENS=24
#
if [ $YYYYSTART -le 2014 ]; then
    echo "use gsim_gfs."
    exit 8
fi
#  Initial conditions and sst sea_ice and snow
#
#  Atmospheric Initial condition
#
SIGDIR=/data/DATABASE/ANALYSIS/GFS/gfs_sig
SSTDIR=/data/DATABASE/ANALYSIS/GFS/gfs_sig
#
INITIAL_SIG_PLATFORM=
INITIAL_SIG_PROTOCOL=ln   # ln, ftp, cp
INITIAL_SIG=$SIGDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/gfs.t\${HHS}z.sanl
INITIAL_SFC=$SIGDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/gfs.t\${HHS}z.sfcanl
INITIAL_SFC_FILE_TYPE=noa1
#
# sst, ice and snow specificatinos
#
# sst
#
SST_PLATFORM=
SST_FTP=ln      # ln, ftp, cp
#if [ ${YYYYSTART} -ge 2016 ]; then
#	SST_ANL_T0=$SSTDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/rtgssthr_grb_0.5.grib2
#	SST_ANL=$SSTDIR/\${YS}/\${MS}/gfs.\${YS}\${MS}\${DS}\${HS}/rtgssthr_grb_0.5.grib2
#else
#	SST_ANL_T0=$SSTDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/gdas1.t\${HHS}z.sstgrb.grib2
#	SST_ANL=$SSTDIR/\${YS}/\${MS}/gfs.\${YS}\${MS}\${DS}\${HS}/gdas1.t\${HS}z.sstgrb.grib2
SST_ANL_T0=/home/mskoo/GRIMs/LSTi/_data/tsfc_ifs_201705-09.nc
SST_ANL=$SST_ANL_T0
SST_GRB_T0=$SST_ANL_T0
SST_GRB=$SST_ANL
#fi
#
#  sea ice
#
# uncomment the following and modify to use observed or persistent sea ice
#   ice is climatology in this example
#
ICE_PLATFORM=
ICE_FTP=ln      # ln, ftp, cp
if [ ${YYYYSTART} -ge 2016 ]; then
	ICE_ANL_T0=$SSTDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/seaice.t00z.grb.grib2
	ICE_ANL=$SSTDIR/\${YS}/\${MS}/gfs.\${YS}\${MS}\${DS}\${HS}/seaice.t00z.grb.grib2
else
	ICE_ANL_T0=$SSTDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/gdas1.t\${HHS}z.engicegrb.grib2
	ICE_ANL=$SSTDIR/\${YS}/\${MS}/gfs.\${YS}\${MS}\${DS}\${HS}/gdas1.t\${HS}z.engicegrb.grib2
fi
#
#  snow
#
SNO_PLATFORM=
SNO_FTP=ln      # ln, ftp, cp
#SNO_ANL_T0=$SSTDIR/\${YYYYS}/\${MMS}/gfs.\${YYYYS}\${MMS}\${DDS}\${HHS}/gdas1.t\${HHS}z.snogrb.grib2
#SNO_ANL=$SSTDIR/\${YS}/\${MS}/gfs.\${YS}\${MS}\${DS}\${HS}/gdas1.t\${HS}z.snogrb.grib2
SNO_ANL_T0=@CON_DIR@/clim.snow.r2.1979-1998.grib
SNO_ANL=@CON_DIR@/clim.snow.r2.1979-1998.grib
SCV_ANL_T0=
SCV_ANL=
#
iicegrb0=1          # 0 : use guess, 1 : use grib file
isnogrb0=0
isstgrb0=1
ism2grb0=0
#
iicegrb=$iicegrb0
isnogrb=$isnogrb0
isstgrb=$isstgrb0
ism2grb=$ism2grb0
#
iicemerge=1         # 1 : merge data at each surface cycling time interval
isnomerge=0         #     (used only with i${fld}grb=1, where fld=ice,sno,sst,scv)
isstmerge=1
iscvmerge=0
#
#  output for archive
#
ARCHIVE_PLATFORM=`hostname`
ARCHIVE_FTP_PROTOCOL=cp
ARCHIVE_DIR=@OUTPUT_DIR@/$RUNNAME/out
#
# Intervals of sfc execution, sigma output, sfc output and flx output
#
INTSFCX=24              # Time interval to run surface merging
INTOMLX=24              # Time interval to run ocean mixed layer model
INTSIG=6                # Time interval to create sigma output file
INTSFC=6                # Time interval to create surface output file
INTFLX=6                # Time interval to create surface flux output file
INTNCO=6                # Time interavl to create nc output file
INTRESTART=480          # Time interval to restart the model
INCHOUR=$INTRESTART     # Forecast hour for each execution
SWHR_GBL=6              # Time interval of shortwave radiation flux (default=6)
LWHR_GBL=6              # Time interval of longwave  radiation flux
                        # (SWHR_GBL and LWHR_BGL should be less than or equal to INTSIG.)
#if [ $INTSIG -lt $SWHR_GBL ]; then SWHR_GBL=$INTSIG ; fi
#if [ $INTSIG -lt $LWHR_GBL ]; then LWHR_GBL=$INTSIG ; fi
#
# Output of monthly averaged file
#       24 : only daily average
#       12 : 00 & 12 UTC average
#       06 : 00, 06, 12, 18 UTC average
#       03 : 00, 03, 06, 09, 12, 15, 18, 21 UTC average
#
#INTAVG=03
INTAVG=24
#
# ---------  Below for expert user only ---------------------
#
FCST_RESTART=yes
#
# If you wish, you may modify EXPDIR to /tmp directory and keep these
# scripts on your permanent disk.
#
EXPDIR=@OUTPUT_DIR@/$RUNNAME
#
EXTVARS=no
#
#  choice of arcihve files and interval
#
#  different archive possible before forecast hour $FHR_1ST_END
#
FHR_1ST_END=744
FTP_SIG_1ST=no
FTP_SFC_1ST=no
FTP_ZNL_1ST=no
FTP_FGB_1ST=no 
FTP_DIA_1ST=no
FTP_KEN_1ST=no
FTP_PGB_1ST=no 
FTP_SGB_1ST=no
FTP_FCSTOUT_1ST=no
FTP_EXTVARS_1ST=no 
FTP_CGS_1ST=no
#
FTP_SIG_2ND=no
FTP_SFC_2ND=no
FTP_ZNL_2ND=no
FTP_FGB_2ND=no
FTP_DIA_2ND=no
FTP_KEN_2ND=no
FTP_PGB_2ND=no
FTP_SGB_2ND=no
FTP_FCSTOUT_2ND=no
FTP_EXTVARS_2ND=no 
FTP_CGS_2ND=no
#
LIST_OF_FILES='sig sfc znl flx fgb dia ken pgb sgb fcstout extvars cgs rivgb'
export LIST_OF_FILES
#
#  files to be kept in the run directory
#
FILES_TO_BE_KEPT='pgb fgb extvars fcstout'
export FILES_TO_BE_KEPT
#
#  grib files to be averaged (monthly)
#
FILES_TO_BE_AVERAGED='pgb fgb'
export FILES_TO_BE_AVERAGED
#
# -------  do not edit below  ------------------------------
#
FCST_NPES=@NPES@
#
mkdir -p $EXPDIR 2>/dev/null
scrnam=`echo $0 | sed 's?.*/??g'`
cp $0 $EXPDIR/0LOG.$scrnam
cp @SRCS_DIR@/define.h $EXPDIR/0LOG.define.h
cp @RUNS_DIR@/namelist.$scrnam $EXPDIR/0LOG.namelist.$scrnam
ls -l @BIN_DIR@ >$EXPDIR/0LOG.bindates
#
#if [ $DDSS -gt 15 ] ; then
#	LENMON=`expr $LENMON + 1`
#fi
#
# save INCHOUR and INTRESTART for modification
#
inchour_orig=$INCHOUR
intrestart_org=$INTRESTART
#
#  Loop for year
#
YYYYSS=$YYYYSTART
while [ $YYYYSS -le $YYYYEND ] ; do
	#
	# Compute ending year, month, day
	#
	YYYYS=$YYYYSS
	MMS=$MMSS
	DDS=$DDSS
	HHS=$HHSS
	MME=`expr $MMS + $LENMON + 1`
	YYYYE=$YYYYS
	while [ $MME -gt 12 ] ; do
		YYYYE=`expr $YYYYE + 1`
		MME=`expr $MME - 12`
	done
	if [ $MME -lt 10 ] ; then
		MME=0$MME
	fi
	DDE=01
	HHE=00
	#
	#  Loop for ensemble member
	#
	YYYY=$YYYYS
	MM=$MMS
	DD=$DDS
	HH=$HHS
	nens=1
	while [ $nens -le $NENS ] ; do
		#
		YMDH=$YYYY$MM$DD$HH
		#
		#  obtain forecast hours for various ending dates
		#
		. @RUNSCR_DIR@/endfhrs
		#
		EXECDIR=$EXPDIR/$YMDH; export EXECDIR
		mkdir -p $EXECDIR
		cd $EXECDIR || exit 8
		#
		# namelist
		#
		. @RUNSCR_DIR@/namelist $EXECDIR
		#
		# Forecast section
		#
		if [ -s sigit -a -s sigitdt -a -s sfci -a "$FCST_RESTART" = yes ];then
			h=`@RUNSCR_DIR@/restart` || exit 8
		else
			#
			# mountain
			#
			if [ ! -s slmsk  -o ! -s oroggd -o ! -s mtnvar ] ; then
				@RUNSCR_DIR@/mtn || exit 8
			fi
			#
			#  fetch sigma and sfc files
			#
			initial_sig=`eval echo $INITIAL_SIG`
			initial_sfc=`eval echo $INITIAL_SFC`
			if [ -s $initial_sig -a -s $initial_sfc ]; then
				@RUNSCR_DIR@/fetchfile $initial_sig ./initial_sig_glb \
					$INITIAL_SIG_PROTOCOL $INITIAL_SIG_PLATFORM || exit 8
				@RUNSCR_DIR@/fetchfile $initial_sfc ./initial_sfc_glb \
					$INITIAL_SIG_PROTOCOL $INITIAL_SIG_PLATFORM || exit 8
			else
				echo 'Initial sigma or surface data is empty.' ; exit 8
			fi
			#
			# Conversion to binary
			#
			FILE_FORMAT=`echo $INITIAL_SIG | sed 's/.*\.//g'`
			if [ "$FILE_FORMAT" != ascii -a \
					"$FILE_FORMAT" != asc -a \
					"$FILE_FORMAT" != ieee -a \
					"$FILE_FORMAT" != ieee_dp -a \
					"$FILE_FORMAT" != ieee_sgi -a \
					"$FILE_FORMAT" != cray ] ; then
				FILE_FORMAT=bin
			fi
			@ETC_DIR@/scnvrt_gfs gsm $INITIAL_SFC_FILE_TYPE \
				@IJCAP@:@ILONF@:@ILATG@:@ILEVS@ \
				-1:-1:-1:-1:-1 \
				ieee:bin initial_sig_glb:initial_sfc_glb \
				initial_sig_bin:initial_sfc_bin || exit 8
			#
			# Change resolution
			#
			@RUNSCR_DIR@/chgr \
					initial_sig_bin initial_sfc_bin \
					sigit sfco \
					$INITIAL_SFC_FILE_TYPE || exit 8
			cp sigit sig.ft00
			cp sigit sigitdt
			#
			h=00
		fi
		#
		#  loop
		#
		xc=0
		while [ $h -lt $ENDHOUR ] ; do
			#
			INCHOUR=$inchour_orig
			INTRESTART=$intrestart_org
			#
			# modify INCHOUR so that 00Z is output time
			#
			if [ $h = 00 -a $HHS != 00 ] ; then
				hhs=`expr $HHS + 0`
				INCHOUR=`expr 24 - $hhs`
			fi
			hx=`expr $h + $INCHOUR`
			#
			# modify INCHOUR so that the forecast end at the end of year
			# this is necessary for matching sst.grib file
			#
			if [ $YEAREND -gt $h -a $YEAREND -le $hx ] ; then
				INCHOUR=`expr $YEAREND - $h`
			fi
			hx=`expr $h + $INCHOUR`
			if [ $hx -gt $ENDHOUR ] ; then
				hx=$ENDHOUR
				INCHOUR=`expr $hx - $h`
			fi
			if [ $INTRESTART -gt $INCHOUR ]; then
				INTRESTART=$INCHOUR
			fi
			if [ $hx -lt 10 ];then hx=0$hx;fi
			echo "`date` $0: fcst from $h to $hx started" >>ERROR.out
			#
			# obtain sst, ice and snow for the current verifying year
			#
			@ETC_DIR@/incdte $YYYY $MM $DD $HH $h >incdte.$$ || exit 8
			read YYYYC dummy dummy dummy <incdte.$$ ; rm incdte.$$
			mkdir -p $EXPDIR/$YYYYC  2>/dev/null
			#  
#mskoo			for fld in sst ice sno scv
			for fld in ice sno scv
			do
				FLD=`echo $fld | tr '[a-z]' '[A-Z]'`
				anl_t0=\$${FLD}_ANL_T0
				anl_t0=`eval echo $anl_t0`
				anl_t0=`eval echo $anl_t0`
				anl_t0_cnvrt=${EXECDIR}/cnvrt_initial_${fld}
				format_anl_t0=`echo $anl_t0 | sed 's/.*\.//g'`
				ftp=\$${FLD}_FTP
				ftp=`eval echo $ftp`
				platform=\$${FLD}_PLATFORM
				platform=`eval echo $platform`
				#
				# sst, ice, snow data format conversion at initial time
				# (from grib2 to grib1)
				#
				if [  $h -eq 0 ] ;then
					if [ -n "$anl_t0" -a "$format_anl_t0" = "grib2" ]; then
						@ETC_DIR@/cnvgrib -g21 ${anl_t0} ${anl_t0_cnvrt}
					fi
				fi
				#
				# obtain sst, ice, snow data format conversion for surface cycling
				#  - format conversion from grib2 to grib1
				#  - extract data 
				#  - merge extracted data at each sfc cycling timesteps
				#
				# variable number in grib1 file
				#
				if [ ${FLD} = SST ];then kpd=11 ; fi
				if [ ${FLD} = ICE ];then kpd=91 ; fi
				if [ ${FLD} = SNO ];then kpd=65 ; fi

				anl=\$${FLD}_ANL
				anl=`eval echo $anl`
				anl=`eval echo $anl`
				anl_cnvrt=${EXECDIR}/cnvrt_${fld}
				format_anl=`echo $anl | sed 's/.*\.//g'`
				imerge=\$i${fld}merge
				imerge=`eval echo $imerge`
				imerge=`eval echo $imerge`
				#
				if [ $imerge -eq 1 ]; then
					nl=1
					hhsfcx=0
					YMDHSFCX=`@ETC_DIR@/validate.s ${YMDH} $h`
					while [ $hhsfcx -lt $INCHOUR ]; do
						if [ $nl -lt 100 ]; then 
							if [ $nl -lt 10 ]; then 
								nl=00$nl
							else
								nl=0$nl 
							fi
						fi
						YS=`echo $YMDHSFCX | cut -c1-4`
						MS=`echo $YMDHSFCX | cut -c5-6`
						DS=`echo $YMDHSFCX | cut -c7-8`
						HS=`echo $YMDHSFCX | cut -c9-10`
						#
						anl=\$${FLD}_ANL
						anl=`eval echo $anl`
						anl=`eval echo $anl`
						anl_temp=${EXECDIR}/cnvrt_${fld}_${nl}
						#
						if [ -s "$anl" ]; then
							if [ "$format_anl" = "grib2" ]; then
					 			@ETC_DIR@/cnvgrib -g21 ${anl} ${anl_temp}
					 			wgrib ${anl_temp} | grep "kpds5=$kpd" | \
					 				wgrib -i -grib ${anl_temp} -o $nl.imsi > dummy.$fld
							elif [ "$format_anl" = "grib" -o "$format_anl" = "grib1" ]; then
								wgrib ${anl} | grep "kpds5=$kpd" | \
									wgrib -i -grib ${anl} -o $nl.imsi > dummy.$fld
							else
								echo "data is not grib file." ; exit 8
							fi
						else
							echo "${FLD} data at $YMDHSFCX is empty."
						fi
						nl=`expr $nl + 1`
						hhsfcx=`expr $hhsfcx + $INTSFCX`
						YMDHSFCX=`@ETC_DIR@/validate.s ${YMDHSFCX} $INTSFCX`
					done
					cat ???.imsi > $anl_cnvrt
					rm -f ???.imsi cnvrt_${fld}_??? dummy.$fld
				fi
				#
				if [ $h -eq 0 ] ;then
					if [ -n "$anl_t0" ] ; then
						if [ $ftp != ln ] ; then
							if [ -s "$anl_t0_cnvrt" ] ; then
								eval anl0=$anl_t0_cnvrt
							else
								eval anl0=$anl_t0
							fi
							@RUNSCR_DIR@/fetchfile  \
								$anl0 $EXPDIR/$YYYYC/$fld.grib \
								$ftp $platform || exit 8
								eval ${FLD}_GRB_T0=$EXPDIR/$YYYYC/$fld.grib
						else
							if [ -s "$anl_t0_cnvrt" ] ; then
								eval ${FLD}_GRB_T0=$anl_t0_cnvrt
							else
								eval ${FLD}_GRB_T0=$anl_t0
							fi
						fi
					else
						eval ${FLD}_GRB_T0=
					fi
				fi
				#
				if [ -n "$anl" ] ; then
					if [ $ftp != ln ] ; then
						if [ -s "$anl_cnvrt" ] ; then
							eval anlh=$anl_cnvrt
						else
							eval anlh=$anl
						fi
						@RUNSCR_DIR@/fetchfile  \
							$anlh $EXPDIR/$YYYYC/$fld.grib \
							$ftp $platform || exit 8
							eval ${FLD}_GRB=$EXPDIR/$YYYYC/$fld.grib
					else
						if [ -s "$anl_cnvrt" ] ; then
							eval ${FLD}_GRB=$anl_cnvrt
						else
							eval ${FLD}_GRB=$anl
						fi
					fi
				else
					eval ${FLD}_GRB=
				fi
			done
			#
			# Convert initial sfc file type to model sfc file type
			#   (run sfc0)
			#
			if [ $h -eq 0 ] ;then
				export SST_GRB_T0 SNO_GRB_T0 ICE_GRB_T0
        		export iicegrb0 isstgrb0 isnogrb0 ism2grb0
				@RUNSCR_DIR@/sfc0 gsm sfco sfci $INITIAL_SFC_FILE_TYPE || exit 8
			    cp sfci sfc.ft00
			fi
			#
			# define ftp output choices (function of $hx)
			#
			if [ $hx -le $FHR_1ST_END ] ; then
				FTP_SIG=$FTP_SIG_1ST
				FTP_SFC=$FTP_SFC_1ST
				FTP_ZNL=$FTP_ZNL_1ST
				FTP_FGB=$FTP_FGB_1ST
				FTP_DIA=$FTP_DIA_1ST
				FTP_KEN=$FTP_KEN_1ST
				FTP_PGB=$FTP_PGB_1ST
				FTP_SGB=$FTP_SGB_1ST
				FTP_FCSTOUT=$FTP_FCSTOUT_1ST
				FTP_EXTVARS=$FTP_EXTVARS_1ST
				FTP_CGS=$FTP_CGS_1ST
			else
				FTP_SIG=$FTP_SIG_2ND
				FTP_SFC=$FTP_SFC_2ND
				FTP_ZNL=$FTP_ZNL_2ND
				FTP_FGB=$FTP_FGB_2ND
				FTP_DIA=$FTP_DIA_2ND
				FTP_KEN=$FTP_KEN_2ND
				FTP_PGB=$FTP_PGB_2ND
				FTP_SGB=$FTP_SGB_2ND
				FTP_FCSTOUT=$FTP_FCSTOUT_2ND
				FTP_EXTVARS=$FTP_EXTVARS_2ND
				FTP_CGS=$FTP_CGS_2ND
			fi
			export FTP_SIG FTP_SFC FTP_ZNL FTP_FGB FTP_DIA FTP_KEN FTP_PGB FTP_SGB \
					FTP_FCSTOUT FTP_EXTVARS FTP_CGS
			#
			#  create fcst.parm
			#
		    export SST_GRB SNO_GRB SCV_GRB ICE_GRB iicegrb isstgrb isnogrb ism2grb
		    export SWHR_GBL LWHR_GBL
			@RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX:$INTOMLX \
						$INTSIG:$INTSFC:$INTFLX:$INTNCO:$INTRESTART || exit 8
	 		#
	 		#  Execute forecast
	 		#
		    if [ "@BATCHQUE@" = qsub ]; then
   			     fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst @BATCHsuffix@`
        		 log_name="fcst.e`echo $fcstid | cut -d'.' -f1`"
		    elif [ "@BATCHQUE@" = llsubmit ]; then
   				 fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst @BATCHsuffix@`
				 log_name="fcst.e`echo $fcstid | cut -d'.' -f2`"
		    elif [ "@BATCHQUE@" = bsub ]; then
    		     fcstid0=`@BATCHQUE@ < @RUNSCR_DIR@/fcst @BATCHsuffix@`
		         fcstid="`echo $fcstid0  | cut -d'<' -f2 | cut -d'>' -f1`"
       			 log_name="fcst.e`echo $fcstid`"
		    fi
	 		#
	 		#  post processing of the forecasts (pgb and average)
	 		#
			archive_dir=`eval echo $ARCHIVE_DIR`
			archive_dir=$archive_dir/$YMDH
			export YYYY MM DD HH h hx INTSFCX INTOMLX INTSFC ENDHOUR INCHOUR INTFLX INTSIG INTAVG archive_dir ARCHIVE_PLATFORM ARCHIVE_FTP_PROTOCOL LIST_OF_FILES FILES_TO_BE_KEPT FILES_TO BE AVERAGED
			if [ "@BATCHQUE@" != "" ]; then
				if [ "@BATCHQUE@" = llsubmit ]; then
					@RUNSCR_DIR@/wait_que_job $fcstid $log_name @BATCHstatus@ || exit 8
					@BATCHQUE@ @RUNSCR_DIR@/post_all
		    	elif [ "@BATCHQUE@" = bsub ]; then
					postid=`@BATCHQUE@ @BATCHdepend@${fcstid} < @RUNSCR_DIR@/post_all @BATCHsuffix@`
					@RUNSCR_DIR@/wait_que_job $fcstid $log_name @BATCHstatus@ || exit 8
					# wait for the last post_all execution
					if [ $YYYYSS -eq $YYYYEND -a $nens -eq $NENS -a $hx -ge $ENDHOUR ] ; then
						@RUNSCR_DIR@/wait_que_job $postid $log_name @BATCHstatus@ || exit 8
					fi
				else
					postid=`@BATCHQUE@ @BATCHdepend@${fcstid} @RUNSCR_DIR@/post_all @BATCHsuffix@`
					@RUNSCR_DIR@/wait_que_job $fcstid $log_name @BATCHstatus@ || exit 8
					# wait for the last post_all execution
					if [ $YYYYSS -eq $YYYYEND -a $nens -eq $NENS -a $hx -ge $ENDHOUR ] ; then
						@RUNSCR_DIR@/wait_que_job $postid $log_name @BATCHstatus@ || exit 8
					fi
				fi
				@RUNSCR_DIR@/wait_sigit_update $hx  || exit 8
			else
				@RUNSCR_DIR@/post_all $YYYY $MM $DD $HH $h $hx $INTSFCX $INTSFC        \
								$ENDHOUR $INCHOUR $INTFLX $INTSIG $INTAVG $archive_dir \
								$ARCHIVE_PLATFORM $ARCHIVE_FTP_PROTOCOL  || exit 8
			fi
            h=$hx
		done
		#
		nens=`expr $nens + 1`
		@ETC_DIR@/incdte $YYYY $MM $DD $HH $INCENS >incdte.out$$ || exit 8
		read YYYY MM DD HH <incdte.out$$
		rm incdte.out$$
		YYYYS=$YYYY
		MMS=$MM
		DDS=$DD
		HHS=$HH
	done
	YYYYSS=`expr $YYYYSS + 1`
done
#
wait
rm -f *.parm *.x cpost* ftp* model_* *.ieee
rm -f fcst.o* fcst.e* pgb.o* pgb.e* fgb.o* fgb.e*
echo "`date` $0: Completely ended"
