#!/bin/sh
set -ax
#
#  This script integrates gcm with climatological daily sst as 
#  a surface forcing (amip run).
#
#   1. Computes monthly mean and deletes daily files every month
#   2. ftp the results to a specified sites
#   3. Should be easily modified to run 'amip' type experiment.
#
# ---------------  User changeable parameters  -------------------------
#
# Change the following variable if you are running separate experiments
# from the same directory
#
RUNNAME=@RUNNAME@
if [ "$RUNNAME" = "" ]; then
    RUNNAME=c_000
fi
#
# If you wish, you may modify EXPDIR to /tmp directory and keep these
# scripts on your permanent disk.
#
EXPDIR=@OUTPUT_DIR@/$RUNNAME
#
# starting and ending forecast years
#
YYYYSTART=1979
YYYYEND=2001
MMSS=01
DDSS=01
HHSS=00
#
# input atmosphereic states
#
INITIAL_SIG_PLATFORM=
INITIAL_SIG_PROTOCOL=ln
INITIAL_SIG=/storage1/REAN/r2/6hour/sig_sfc/sig.anl.1979010100.ieee
INITIAL_SFC=/storage1/REAN/r2/6hour/sig_sfc/sfc.anl.1979010100.ieee
INPUT_RESOLUTION=t62k28
INITIAL_SFC_FILE_TYPE=osu1
#
# sst, ice and snow specificatinos
#
# sst
#
SST_PLATFORM=
SST_FTP=ln
SST_ANL_T0=/storage1/SST/gisst22.\$YYYYS.daily
SST_ANL=/storage1/SST/gisst22.\$YYYYS.daily
#
#  sea ice
#
# uncomment the following and modify to use observed or persistent sea ice
#   ice is climatology in this example
#
ICE_PLATFORM=
ICE_FTP=ln
ICE_ANL_T0=
ICE_ANL=@CON_DIR@/clim.ice.grib
#
#  snow
#
SNO_PLATFORM=
SNO_FTP=ln
SNO_ANL_T0=@CON_DIR@/clim.snow.grib
SNO_ANL=@CON_DIR@/clim.snow.grib
SCV_ANL_T0=
SCV_ANL=
#
iicegrb0=1                      # 0 : use guess, 1 : use grib file
isnogrb0=0
isstgrb0=1
ism2grb0=0
#
iicegrb=$iicegrb0
isnogrb=$isnogrb0
isstgrb=$isstgrb0
ism2grb=$ism2grb0
#
#  output for archive 
#
ARCHIVE_PLATFORM=`hostname`
ARCHIVE_FTP_PROTOCOL=cp
ARCHIVE_DIR=$EXPDIR/out
#
# Intervals of sfc execution, sigma output, sfc output and fgb output
#
INTSFCX=24
INTSIG=6
INTSFC=6
INTFLX=6
INTRESTART=240
INCHOUR=240
#
# Output of monthly averaged file
#       24 : only daily average
#       12 : 00 & 12 UTC average
#       06 : 00, 06, 12, 18 UTC average
#
INTAVG=24
#
#  automatic restart of forecast from where it is ended before
#
FCST_RESTART=yes
#
#  ---------------------  below for expert user only -----------------
#
EXTVARS=no
#
#  choice of arcihve fiels and interval
#
#  different archive possible before forecast hour $FHR_1ST_END
#
FHR_1ST_END=744
FTP_SIG_1ST=no
FTP_SFC_1ST=no
FTP_ZNL_1ST=no
FTP_FGB_1ST=no
FTP_DIA_1ST=no
FTP_KEN_1ST=no
FTP_PGB_1ST=no
FTP_SGB_1ST=no
FTP_FCSTOUT_1ST=no
FTP_EXTVARS_1ST=no
FTP_CGS_1ST=no
#
FTP_SIG_2ND=no
FTP_SFC_2ND=no
FTP_ZNL_2ND=no
FTP_FGB_2ND=no
FTP_DIA_2ND=no
FTP_KEN_2ND=no
FTP_PGB_2ND=no
FTP_SGB_2ND=no
FTP_FCSTOUT_2ND=no
FTP_EXTVARS_2ND=no
FTP_CGS_2ND=no
#
LIST_OF_FILES='sig sfc znl flx fgb dia ken pgb sgb fcstout extvars cgs'
export LIST_OF_FILES
#
#  files to be kept in the run directory
#
FILES_TO_BE_KEPT='pgb fgb extvars fcstout'
export FILES_TO_BE_KEPT
#
#  grib files to be averaged (monthly)
#
FILES_TO_BE_AVERAGED='pgb fgb'
export FILES_TO_BE_AVERAGED
#
# -------  do not edit below  ------------------------------
#
FCST_NPES=@NPES@
#
mkdir -p $EXPDIR 2>/dev/null
scrnam=`echo $0 | sed 's?.*/??g'`
cp $0 $EXPDIR/0LOG.g.$scrnam
cp @SRCS_DIR@/define.h $EXPDIR/0LOG.g.define.h
ls -l @BIN_DIR@ >$EXPDIR/0LOG.g.bindates
#
# Environmental variables for thread mode
#
. @RUNSCR_DIR@/envset
#
#if [ $DDSS -gt 15 ] ; then
#       LENMON=`expr $LENMON + 1`
#fi
#
# save INCHOUR and INTRESTART for modification
#
inchour_orig=$INCHOUR
intrestart_org=$INTRESTART
#
#  Loop for year
#
YYYYS=$YYYYSTART
MMS=$MMSS
DDS=$DDSS
HHS=$HHSS
#
while [ $YYYYS -le $YYYYEND ] ; do
	#
	# Compute ending year, month, day
	#
	YYYY=$YYYYS
	if [ $YYYY -eq $YYYYSTART ] ; then
		MM=$MMS
		DD=$DDS
		HH=$HHS
	elif [ $YYYY -gt $YYYYSTART -a $YYYYS -lt $YYYYEND ] ; then
		MM=01
		DD=01
		HH=00
	else
		MM=01
		DD=01 
		HH=00
	fi
	MMS=$MM
	DDS=$DD
	HHS=$HH
	#
	EXECDIR=$EXPDIR/$YYYY
	mkdir -p $EXECDIR
	cd $EXECDIR
	#
	YYYYE=`expr $YYYY + 1`
	MME=01
	DDE=01
	HHE=00
	#
	#  obtain forecast hours for various ending dates
	#
	. @RUNSCR_DIR@/endfhrs
	#
	# Forecast section
	#
	if [ -s sigit -a -s sigitdt -a -s sfci -a "$FCST_RESTART" = yes ];then
		h=`@RUNSCR_DIR@/restart` || exit 8
	else
		#
		# co2
		#
		if [ ! -s co2con ] ; then
			@RUNSCR_DIR@/co2 || exit 8
		fi
		#
		# mtn
		#
		if [ ! -s slmsk  -o ! -s oroggd -o ! -s mtnvar ] ; then
			@RUNSCR_DIR@/mtn || exit 8
		fi
		#
		#  fetch sigma and sfc files
		#
		initial_sig=`eval echo $INITIAL_SIG`
		initial_sfc=`eval echo $INITIAL_SFC`
		if [ $YYYY -gt $YYYYSTART ] ; then
			if [ ! -s sigit -o ! -s sfci ] ; then
				YYYYM=`expr $YYYY - 1 `
				SIG_FILE=$EXPDIR/$YYYYM/sigit
				SIGDT_FILE=$EXPDIR/$YYYYM/sigitdt
				SFC_FILE=$EXPDIR/$YYYYM/sfci
				#
				if [ ! -s $SIG_FILE -o ! -s $SIGDT_FILE -o ! -s $SFC_FILE ] ; then
					echo "`date` $0: Start of year $YYYY sigma and/or sfc file not found" >> ERROR.out
					exit 8
				fi
				#
				# Reset initial date
				#
				@ETC_DIR@/date $SIG_FILE >date.$$ || exit 8
				read orighh origmm origdd origyy origfh <date.$$ ; rm date.$$
				@ETC_DIR@/incdte $origyy $origmm $origdd $orighh $origfh >incdte.$$ || exit 8
				read yyyy_reset MM DD HH<incdte.$$ ; rm incdte.$$
				#
				if [ $yyyy_reset -ne $YYYY ] ; then
					echo "`date` $0: Date Error.  yyyy_reset=$yyyy_reset Should be $YYYY" >>ERROR.out
					exit 8
				fi
				#
				if [ $MM != 01 -o $DD != 01 -o $HH != 00 ] ; then
					echo "`date` $0: Date Error. mm=$MM dd=$DD hh=$HH Should be 01 01 0 0" >>ERROR.out
					exit 8
				fi
				#
				echo $YYYY $MM $DD $HH
				if [ @MODEL@ = dfs ]; then
					cp $EXPDIR/$YYYYM/sigit $EXECDIR/initial_sig
					cp $EXPDIR/$YYYYM/sfci  $EXECDIR/initial_sfc
					@ETC_DIR@/chgdates noa1 @IJCAP@:@ILONF@:@ILATG@:@LEVS@:4 \
						$YYYY:01:01:00:00 initial_sig:initial_sfc sigit:sfci dfs || exit 8
					cp $EXECDIR/sigit sigitdt
				else
					@ETC_DIR@/scnvrt gsm @FCST_SFC_FILE_TYPE@ \
						@IJCAP@:@ILONF@:@ILATG@:@LEVS@ \
						$YYYY:01:01:00:0 \
						bin:bin $SIG_FILE:$SFC_FILE \
						$EXECDIR/initial_sig_bin:$EXECDIR/initial_sfc_bin || exit 8
					#
					cp $EXECDIR/initial_sig_bin $EXECDIR/sigit
					cp $EXECDIR/initial_sig_bin $EXECDIR/sigitdt
					cp $EXECDIR/initial_sfc_bin $EXECDIR/sfci
				fi
			fi
		else
			@RUNSCR_DIR@/fetchfile $initial_sig ./initial_sig_glb \
				$INITIAL_SIG_PROTOCOL $INITIAL_SIG_PLATFORM || exit 8
			@RUNSCR_DIR@/fetchfile $initial_sfc ./initial_sfc_glb \
				$INITIAL_SIG_PROTOCOL $INITIAL_SIG_PLATFORM || exit 8
			#
			# Conversion to binary
			#
			FILE_FORMAT=`echo $INITIAL_SIG | sed 's/.*\.//g'`
			if [ "$FILE_FORMAT" != ascii -a \
				"$FILE_FORMAT" != asc -a \
				"$FILE_FORMAT" != ieee -a \
				"$FILE_FORMAT" != ieee_dp -a \
				"$FILE_FORMAT" != ieee_sgi -a \
				"$FILE_FORMAT" != cray ] ; then
				FILE_FORMAT=bin
			fi
			@ETC_DIR@/scnvrt gsm $INITIAL_SFC_FILE_TYPE \
				@IJCAP@:@ILONF@:@ILATG@:@ILEVS@ \
				-1:-1:-1:-1:-1 \
				$FILE_FORMAT:bin initial_sig_glb:initial_sfc_glb \
				initial_sig_bin:initial_sfc_bin || exit 8
			#
			# Change resolution
			#
			@RUNSCR_DIR@/chgr \
					initial_sig_bin initial_sfc_bin \
					sigit sfci \
					$INITIAL_SFC_FILE_TYPE || exit 8
		fi
		#
		cp sigit sigitdt
		cp sigit sig.ft00
		cp sfci sfc.ft00
		#
		h=00
	fi
	#
	#  loop
	#
	xc=0
	while [ $h -lt $ENDHOUR ] ; do
		#
		INCHOUR=$inchour_orig
		INTRESTART=$intrestart_org
		#
		# modify INCHOUR so that 00Z is output time
		#
		if [ $h = 00 -a $HHS != 00 ] ; then
			hhs=`expr $HHS + 0`
			INCHOUR=`expr 24 - $hhs`
		fi
		hx=`expr $h + $INCHOUR`
		#
		# modify INCHOUR so that the forecast end at the end of year
		# this is necessary for matching sst.grib file
		#
		if [ $YEAREND -gt $h -a $YEAREND -le $hx ] ; then
			INCHOUR=`expr $YEAREND - $h`
		fi
		hx=`expr $h + $INCHOUR`
		if [ $hx -gt $ENDHOUR ] ; then
			hx=$ENDHOUR
			INCHOUR=`expr $hx - $h`
		fi
		if [ $INTRESTART -gt $INCHOUR ]; then
			INTRESTART=$INCHOUR
		fi
		if [ $hx -lt 10 ];then hx=0$hx;fi
		echo "`date` $0: fcst from $h to $hx started" >>ERROR.out
		#
		# obtain sst, ice and snow for the current verifying year
		#
		@ETC_DIR@/incdte $YYYY $MM $DD $HH $h >incdte.$$ || exit 8
		read YYYYC dummy dummy dummy <incdte.$$ ; rm incdte.$$
		mkdir -p $EXPDIR/$YYYYC  2>/dev/null
		#
		for fld in sst sno scv ice ; do
			FLD=`echo $fld | tr '[a-z]' '[A-Z]'`
			anl_t0=\$${FLD}_ANL_T0
			anl_t0=`eval echo $anl_t0`
			anl_t0=`eval echo $anl_t0`
			anl=\$${FLD}_ANL
			anl=`eval echo $anl`
			anl=`eval echo $anl`
			ftp=\$${FLD}_FTP
			ftp=`eval echo $ftp`
			platform=\$${FLD}_PLATFORM
			platform=`eval echo $platform`
			if [ $h -eq 0 ] ;then
				if [ -n "$anl_t0" ] ; then
					if [ $ftp != ln ] ; then
						@RUNSCR_DIR@/fetchfile  \
							$anl $EXPDIR/$YYYYC/$fld.grib \
							$ftp $platform || exit 8
							eval ${FLD}_GRB_T0=$EXPDIR/$YYYYC/$fld.grib
					else
						eval ${FLD}_GRB_T0=$anl_t0
					fi
				else
					eval ${FLD}_GRB_T0=
				fi
			fi
			if [ -n "$anl" ] ; then
				if [ $ftp != ln ] ; then
					@RUNSCR_DIR@/fetchfile  \
						$anl $EXPDIR/$YYYYC/$fld.grib \
						$ftp $platform || exit 8
					eval ${FLD}_GRB=$EXPDIR/$YYYYC/$fld.grib
				else
					eval ${FLD}_GRB=$anl
				fi
			else
				eval ${FLD}_GRB=
			fi
		done
		#
		# run sfc0
		#
		if [ $h -eq 0 -a $YYYY -eq $YYYYSTART ] ;then
			export SST_GRB_T0 SNO_GRB_T0 ICE_GRB_T0
			export iicegrb0 isstgrb0 isnogrb0 ism2grb0
			@RUNSCR_DIR@/sfc0 gsm sfci sfco $INITIAL_SFC_FILE_TYPE || exit 8
			mv sfco sfci
		fi
		#
		# define ftp output choices (function of $hx)
		#
		if [ $hx -le $FHR_1ST_END ] ; then
			FTP_SIG=$FTP_SIG_1ST
			FTP_SFC=$FTP_SFC_1ST
			FTP_ZNL=$FTP_ZNL_1ST
			FTP_FGB=$FTP_FGB_1ST
			FTP_DIA=$FTP_DIA_1ST
			FTP_KEN=$FTP_KEN_1ST
			FTP_PGB=$FTP_PGB_1ST
			FTP_SGB=$FTP_SGB_1ST
			FTP_FCSTOUT=$FTP_FCSTOUT_1ST
			FTP_EXTVARS=$FTP_EXTVARS_1ST
			FTP_CGS=$FTP_CGS_1ST
		else
			FTP_SIG=$FTP_SIG_2ND
			FTP_SFC=$FTP_SFC_2ND
			FTP_ZNL=$FTP_ZNL_2ND
			FTP_FGB=$FTP_FGB_2ND
			FTP_DIA=$FTP_DIA_2ND
			FTP_KEN=$FTP_KEN_2ND
			FTP_PGB=$FTP_PGB_2ND
			FTP_SGB=$FTP_SGB_2ND
			FTP_FCSTOUT=$FTP_FCSTOUT_2ND
			FTP_EXTVARS=$FTP_EXTVARS_2ND
			FTP_CGS=$FTP_CGS_2ND
		fi
		export FTP_SIG FTP_SFC FTP_ZNL FTP_FGB FTP_DIA FTP_KEN FTP_PGB FTP_SGB \
			FTP_FCSTOUT FTP_EXTVARS FTP_CGS
		#
		#  create fcst.parm
		#
		export SST_GRB SNO_GRB ICE_GRB
		export iicegrb isstgrb isnogrb ism2grb
		@RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX \
			$INTSIG:$INTSFC:$INTFLX:$INTRESTART || exit 8
		#
		#  Execute forecast
		#
	    if [ "$BATCHQUE" = qsub ]; then
   	     fcstid=`$BATCHQUE @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     log_name="fcst.e`echo $fcstid | cut -d'.' -f1`"
	    elif [ "$BATCHQUE" = llsubmit ]; then
   	     fcstid=`$BATCHQUE @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     log_name="fcst.e`echo $fcstid | cut -d'.' -f2`"
		elif [ "$BATCHQUE" = bsub ]; then
   	     fcstid0=`$BATCHQUE < @RUNSCR_DIR@/fcst @BATCHsuffix@`
   	     fcstid="`echo $fcstid0  | cut -d'<' -f2 | cut -d'>' -f1`"
   	     log_name="fcst.e`echo $fcstid`"
		fi
		#
		#  Post processing of the forecasts (pgb and average)
		#
		archive_dir=`eval echo $ARCHIVE_DIR`
		archive_dir=$archive_dir/$YMDH
		export YYYY MM DD HH h hx INTSFCX INTOMLX INTSFC ENDHOUR INCHOUR INTFLX INTSIG INTAVG archive_dir ARCHIVE_PLATFORM ARCHIVE_FTP_PROTOCOL LIST_OF_FILES FILES_TO_BE_KEPT FILES_TO BE AVERAGED
		if [ "$BATCHQUE" != "" ]; then
			if [ "$BATCHQUE" = llsubmit ]; then
				@RUNSCR_DIR@/wait_que_job $fcstid $log_name $BATCHstatus || exit 8
				${BATCHQUE} @RUNSCR_DIR@/post_all
			elif [ "$BATCHQUE" = bsub ]; then
				${BATCHQUE} ${BATCHdepend} "done(${fcstid})" < @RUNSCR_DIR@/post_all
				@RUNSCR_DIR@/wait_que_job $fcstid $log_name $BATCHstatus || exit 8
			else
				${BATCHQUE} ${BATCHdepend}${fcstid} @RUNSCR_DIR@/post_all
				@RUNSCR_DIR@/wait_que_job $fcstid $log_name $BATCHstatus || exit 8
			fi
			@RUNSCR_DIR@/wait_sigit_update $hx  || exit 8
		else
			@RUNSCR_DIR@/post_all $YYYY $MM $DD $HH $h $hx $INTSFCX $INTSFC        \
						$ENDHOUR $INCHOUR $INTFLX $INTSIG $INTAVG $archive_dir \
						$ARCHIVE_PLATFORM $ARCHIVE_FTP_PROTOCOL  || exit 8
		fi
		h=$hx
	done
	#
	YYYYS=`expr $YYYY + 1`
done
#
wait
rm -f *.parm *.x ftp* model_* *.ieee tmp.*
echo "`date` $0: Completely ended"
