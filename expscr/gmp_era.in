#!/bin/sh 
set -ax
#
# this script makes 72 hour integration starting from an example initial
# condition. ideal for first testing the system on new computer system
#
# ---------------  user changeable parameters ------------------------
#
# Change the following variable if you are running separate experiments
# from the same directory
#
# experiment name
#
RUNNAME=
#
# Intervals of sfc execution, sigma output, sfc output and flx output
# Various options for running the model
#
SDATE=${SDATE:=2017010100}  # Starting forecast date
ENDHOUR=`expr 24 \* 2`  # Length of model integration in hour
INTPOST=$ENDHOUR        # Time interval to create output files for the first execution
INCHOUR=$INTPOST        # Forecast hour for the first execution
INTSFCX=10000000        # Time interval to run surface merging
INTOMLX=24              # Time interval to run ocean mixed layer model
INTSIG=6                # Time interval to create sigma output file
INTSFC=$INTSIG          # Time interval to create surface output file
INTFLX=$INTSFC          # Time interval to create surface flux output file
INTNCO=$INTSIG          # Time interavl to create nc output file
INTSIG2=6               # Time interval to create sigma output file after first execution
INTSFC2=$INTSIG2        # Time interval to create surface output file after first execution
INTFLX2=$INTSFC2        # Time interval to create nc output file
INTNCO2=$INTSIG2        # Time interval to create surface flux output file after first execution
SWHR_GBL=1              # Time interval of shortwave radiation flux (default=6)
LWHR_GBL=1              # Time interval of longwave  radiation flux
INTRESTART=$ENDHOUR     # Time interval to restart the model
#
NENS_STOCH=1            # Ensemble number for stochastic perturbation
#
FCST_RESTART=yes        # Option indicating whether current forecast is first
DEL_FLUX=yes            # Option deleting flux file after forecst (yes;no)
SIG_GRIB=no             # Option gribing at sigma layer after forecst (yes;no)
POST_SFC=no             # Option post-processing for surface (yes;no or resol.)
DEL_BINARY=no           # Option deleting binary output after POST_SFC (yes;no)
#
SFC_FCST=no             # Option using surface fcst data
SFC_ASSI_HOUR=12        # Time interval of surface fcst data
#
# ------------- below for expert user only -------------------------------------
#
# If you wish, you may modify EXECDIR to /tmp directory and keep these
# scripts on your permanent disk.
#
SYEAR=`echo $SDATE|cut -c1-4`
SMON=`echo $SDATE|cut -c5-6`
SDAY=`echo $SDATE|cut -c7-8`
SHOUR=`echo $SDATE|cut -c9-10`
SYYYYMMDD=`echo $SDATE|cut -c1-8`
if [ -z $RUNNAME ]; then
	EXECDIR=@OUTPUT_DIR@/$SDATE
else 
	EXECDIR=@OUTPUT_DIR@/$RUNNAME
fi
export EXECDIR SDATE
#
# -------------  do not change below  ------------------------------------------
#
FHOUR=`expr $SFC_ASSI_HOUR \* -1`
FDATE=`@ETC_DIR@/validate.s ${SDATE} ${FHOUR}`
FCSTDIR=@OUTPUT_DIR@/${FDATE}
#
mkdir -p $EXECDIR 2>/dev/null
#
# namelist
#
. @RUNSCR_DIR@/namelist $EXECDIR
#gaon2
#ERA_DIR=/data2/valid/khseol/ERA5/${SYEAR}${SMON}
ERA_DIR=/home/mskoo/GRIMs/grimsini/era
GFS_DIR=/home/mskoo/GRIMs/grimsini/gfs/gfs.${SDATE}
#nuri/miri
#ERA_DIR=/s3/data/kiaps/khseol/DATABASE/ERA5/${SYEAR}/${SMON}
#GFS_DIR=/s4/home/kiaps/kiaps-val/DATABASE/ANALYSIS/GFS/gfs_sig/${SYEAR}/${SMON}/gfs.${SDATE}
#
INITIAL_SIG=${ERA_DIR}/ERA5_anal_ml_${SYEAR}${SMON}${SDAY}_0000.nc
INITIAL_SFC=${GFS_DIR}/gfs.t${SHOUR}z.sfcanl
if [ ${SDATE} -ge 2017071912 ]; then
    INITIAL_SFC=${GFS_DIR}/gfs.t${SHOUR}z.sfcanl.nemsio
else
    INITIAL_SFC=${GFS_DIR}/gfs.t${SHOUR}z.sfcanl
fi
INITIAL_SFC_FCST=${FCSTDIR}/sfc.ft${SFC_ASSI_HOUR}
#
# blank means use guess (in the sfc file).
#
if [ ${SYEAR} -ge 2015 ]; then
    SST_ANL_T0=${GFS_DIR}/rtgssthr_grb_0.5.grib2
    ICE_ANL_T0=${GFS_DIR}/seaice.t00z.grb.grib2
    SNO_ANL_T0=
    SCV_ANL_T0=
    iicegrb0=1              # 0 : use guess, 1 : use grib file
    isnogrb0=0
    isstgrb0=1
    ism2grb0=0
    SST_ANL=${EXECDIR}/cnvrt_initial_sst
    ICE_ANL=${EXECDIR}/cnvrt_initial_ice
    SNO_ANL=
    SCV_ANL=
else
	SST_ANL_T0=${GFS_DIR}/gdas1.t${SHOUR}z.sstgrb.grib2
	ICE_ANL_T0=${GFS_DIR}/gdas1.t${SHOUR}z.engicegrb.grib2
	SNO_ANL_T0=
	SCV_ANL_T0=
	iicegrb0=1              # 0 : use guess, 1 : use grib file
	isnogrb0=0
	isstgrb0=1
	ism2grb0=0
	SST_ANL=${EXECDIR}/cnvrt_initial_sst
	ICE_ANL=${EXECDIR}/cnvrt_initial_ice
	SNO_ANL=
	SCV_ANL=
fi
#
iicegrb=$iicegrb0
isnogrb=$isnogrb0
isstgrb=$isstgrb0
ism2grb=$ism2grb0
#
INPUT_RESOLUTION=t@IJCAP@k@ILEVS@
#
FCST_NPES=@NPES@
FCST_NCPUS=@NCPUS@
#
# cd to run directory
#
scrnam=`echo $0 | sed 's?.*/??g'`
cp $0 $EXECDIR/0LOG.$scrnam
cp @SRCS_DIR@/define.h $EXECDIR/0LOG.define.h
ls -l @BIN_DIR@ >$EXECDIR/0LOG.bindates
cd $EXECDIR || exit 8
#
# renew log file
#
cat @PWD@/$0 > ERROR.out
echo '==============' >>ERROR.out
#
# Automatic restart
#
if [ @BARO_TEST@ != 1 ]; then
	if [ -s sigit -a -s sigitdt -a -s sfci -a "$FCST_RESTART" = yes ]; then
		#
		# Restart
		#
		h=`@ETC_DIR@/fhour sigit`
        if [ "$h" == "" ]; then
            echo "error in reading forecast hour of sigit."
            exit 8
        else
            echo fhour in the sigit file = $h
        fi
	else
		#
		# mountain
		#
		if [ ! -s slmsk  -o ! -s oroggd -o ! -s mtnvar ] ; then
			@RUNSCR_DIR@/mtn || exit 8
		fi
		#
		# Initial start.
		#
		h=00
		#
		# Format conversion from grib2 to grib1
		#
		if [ -s $SST_ANL_T0 ]; then
			@ETC_DIR@/cnvgrib -g21 ${SST_ANL_T0} ${SST_ANL}
		else
			echo 'SST data is empty.' ; exit 8
		fi
		if [ -s $ICE_ANL_T0 ]; then
			@ETC_DIR@/cnvgrib -g21 ${ICE_ANL_T0} ${ICE_ANL}
		else
			echo 'ICE data is empty.' ; exit 8
		fi
		if [ -s $SNO_ANL_T0 ]; then
			@ETC_DIR@/cnvgrib -g21 ${SNO_ANL_T0} ${SNO_ANL}
		else
			echo 'SNOW data is empty.' ; exit 8
		fi
		#
		# Change input resolution to model resolution
		#
		@RUNSCR_DIR@/chgr $INITIAL_SIG 'era' || exit 8
		#
		# Convert initial sfc file type to model sfc file type
		#
		SST_GRB_T0=`eval echo $SST_ANL`
		SNO_GRB_T0=`eval echo $SNO_ANL`
		SCV_GRB_T0=`eval echo $SCV_ANL`
		ICE_GRB_T0=`eval echo $ICE_ANL`
		export SST_GRB_T0 SNO_GRB_T0 SCV_GRB_T0 ICE_GRB_T0
		export iicegrb0 isstgrb0 isnogrb0 ism2grb
		@RUNSCR_DIR@/sfc0 gsm $INITIAL_SFC || exit 8
		#
		cp sigit sigitdt  || exit 8
		cp sigit sig.ft$h || exit 8
		cp sfci  sfc.ft$h || exit 8
		#
		@ETC_DIR@/date sigit >date.$$ || exit 8
		read HH MM DD YYYY FH <date.$$ ; rm date.$$
		echo $YYYY $MM $DD $HH $FH
	fi
else
	h=0
fi
#
#  forecast hour loop
#
xc=0
while [ $h -lt $ENDHOUR ] ; do
	#
	hx=`expr $h + $INCHOUR`
	if [ $hx -gt $ENDHOUR ] ; then
		hx=$ENDHOUR
	fi
    if [ $hx -gt $INTPOST ] ; then
        if [ $h -lt $INTPOST ] ; then
            INCHOUR=`expr $INTPOST - $h`
            hx=$INTPOST
        else
            INCHOUR=`expr $ENDHOUR - $h`
            hx=$ENDHOUR
            INTSIG=$INTSIG2
            INTSFC=$INTSFC2
            INTFLX=$INTFLX2
            INTNCO=$INTNCO2
        fi
    fi
	if [ $hx -lt 10 ];then hx=0$hx;fi
	#
	SST_GRB=`eval echo $SST_ANL`
	SNO_GRB=`eval echo $SNO_ANL`
	SCV_GRB=`eval echo $SCV_ANL`
	ICE_GRB=`eval echo $ICE_ANL`
	export SST_GRB SNO_GRB SCV_GRB ICE_GRB iicegrb isstgrb isnogrb ism2grb
	export SWHR_GBL LWHR_GBL NENS_STOCH
	@RUNSCR_DIR@/fcstparm $INCHOUR $ENDHOUR $INTSFCX:$INTOMLX \
						$INTSIG:$INTSFC:$INTFLX:$INTNCO:$INTRESTART || exit 8
	#
	# Execute forecast
	#
    if [ "@BATCHQUE@" == "qsub" ]; then
#		@BATCHQUE@ -W block=true @RUNSCR_DIR@/fcst || exit 8
        fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst`
        log_name="fcst.e`echo $fcstid | cut -d'.' -f1`"
	else
		fcstid=`@BATCHQUE@ @RUNSCR_DIR@/fcst @BATCHsuffix@`
    fi
	#
	# Postprocess (pgb, fgb)
	#
	if [ @BARO_TEST@ != 1 ]; then
		if [ @DOPOST@ = yes ] ; then
			phs=$h
			phe=$hx
			phinc=$INTSIG
			fhs=$h
			fhe=$hx
			fhinc=$INTFLX
			if [ $h -gt 0 ]; then
				phs=`expr $h + $INTSIG`
				fhs=`expr $h + $INTFLX`
			fi
			export phs phe phinc fhs fhe fhinc SIG_GRIB POST_SFC DEL_BINARY
			if [ "@BATCHQUE@" == "qsub" ]; then
#				@BATCHQUE@ -W block=true @RUNSCR_DIR@/post_gmp || exit 8
                @RUNSCR_DIR@/wait_que_job $fcstid $log_name @BATCHstatus@ || exit 8
                postid=`@BATCHQUE@ @RUNSCR_DIR@/post_gmp`
			else
				@RUNSCR_DIR@/post_gmp $phs $phe $phinc  || exit 8
			fi
			#
            # Wait queue job for post
            #
#            if [ "@BATCHQUE@" != "" ]; then
                @RUNSCR_DIR@/wait_que_job $postid $log_name @BATCHstatus@ || exit 8
				# delete flux file
				if [ "$DEL_FLUX" = yes ]; then
					if [ -s fgb.ft$fhe ]; then
  	 	 				@RUNSCR_DIR@/delfile flx 0 $hx $INTFLX || exit 8
					fi
				fi
#            fi
			#
			# archive files
			#
            if [ "$CPSCLD" = "define" ]; then
                cp cpscld.ft$hx cpscldi || exit 8
            fi
		elif [ @CATPGB@ = yes ] ; then
			@ETC_DIR@/catpgb
		fi
	fi
	#
	h=$hx
done
#
wait
#rm -f fcst.e* fcst.o* pgb.o* pgb.e* fgb.o* fgb.e*
echo "`date` $0: Completely ended"
#
if [ @SYSTEM@ = mac -a @MARCH@ = mpi ] ; then
	lamclean
	lamhalt
fi
