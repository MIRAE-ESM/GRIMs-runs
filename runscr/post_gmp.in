#!/bin/sh
#------------------------------------------------------------------end_of_header
#
#  abstract: do post process
#
#-------------------------------------------------------------------------------
phs=${phs:=$1}
phe=${phe:=$2}
phinc=${phinc:=$3}
fhs=${fhs:=$1}
fhe=${fhe:=$2}
fhinc=${fhinc:=$3}
EXECDIR=${EXECDIR:=$4}
if [ "$EXECDIR" == "" ]; then
	EXECDIR=`pwd`
fi
#
# post process
#
echo "-> do fgb"
@RUNSCR_DIR@/fgb $fhs $fhe $fhinc $EXECDIR || exit 8
echo "-> do pgb"
@RUNSCR_DIR@/pgb $phs $phe $phinc $EXECDIR || exit 8
if [ "$SIG_GRIB" = "yes" ]; then
	echo "-> do sgb"
	@RUNSCR_DIR@/sgb $phs $phe $phinc $EXECDIR
fi
#
# post process for surface
#
if [ "$POST_SFC" == "yes" ]; then
	cd $EXECDIR
	${BATCHQUE} @RUNSCR_DIR@/post_gmp_sfc
fi
 
exit 0
