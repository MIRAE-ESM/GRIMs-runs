#!/bin/sh
#
#  change 2-digit year to 4-digit year in sigma file
# 
#  $1 is input sigma file
#  $2 is output sigma file
# 
if [ $# -ne 3 ];then
	echo "$0 in_sig out_sig century"
	exit 1
fi
in_sig=$1
out_sig=$2
cent=$3
#
if [ -s $in_sig ] ; then
	@ETC_DIR@/date $in_sig >date.out || exit 8
	read hh mm dd yyyy fh <date.out
fi
if [ -s $in_sig ] ; then
	if [ "@MODEL@" != rmp ] ; then
		if [ $mm != $mms -o $dd != $dds -o $hh != $hhs -o \
					$fh != $fhs ] ; then
			echo 'date record of sig does not match'
			echo "sigma: $yyyy/$mm/$dd/$hh/$fh"
			exit 1
		fi
	fi
fi
if [ $yyyy -gt $yyyys ]; then
	yyyy=$yyyys
fi
if [ $yyyy -le 100 ] ; then
	yyyy=`expr \( \( $cent - 1 \) \* 100 \) + $yyyy`
	echo "yyyy lt 100 and will be modified to 4-digit $yyyy"
	@RUNENV@ @RUNSCR_DIR@/chgdates $yyyy:$mm:$dd:$hh:$fh \
	$in_sig:dummy $out_sig:dummy || exit 8
else
	cp $in_sig $out_sig
	if [ $? -ne 0 ] ; then
		echo "`date` $0: cp $in_sig $out_sig failed" >>ERROR.out
		exit 8
	fi
fi
