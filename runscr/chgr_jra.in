#!/bin/sh
#-------------------------------------------------------------------------------
#
# [abstract] JRA data process for grims initial data
#
# [history]
#   2020-08-11 myung-seo koo   initial development
#
#-------------------------------------------------------------------------------
#vars='psfc hgt ugrd vgrd tmp spfh'
vars='hgt ugrd vgrd tmp spfh'

# export variables
obj=${JRA_TYPE}
stime=${SDATE}
mdir=${JRA_PRESSURE_DIR}
execdir=${EXECDIR}

# time information
yyyy=`echo $stime | cut -c 1-4`
mm=`echo $stime | cut -c 5-6`
dd=`echo $stime | cut -c 7-8`
hh=`echo $stime | cut -c 9-10`
yymmddhh=`echo $stime | cut -c3-10`

# do-loop for variables
for var in $vars; do

	# file for variable
	if [ "$var" == "psfc" ]; then
		idir="${mdir}/PRESsfc"
		ifile=`ls ${idir}/anl*pres.${yyyy}${mm}*`
	else
		idir="${mdir}/${var}/${yyyy}"
		ifile=`ls ${idir}/anl*${var}.${yyyy}${mm}*`
	fi
	ofile=$execdir/${stime}.grib

	# extract variable
	echo "extract ${var} from ${ifile}"
	wgrib -s ${ifile} 2>&1 | grep "$yymmddhh" | wgrib -i -grib ${ifile} -append -o ${ofile} > dummy.wgrib 2>&1

done

# p2sig
ifmoisrh=0
ifheight=1
iupd5=33
ivpd5=34
itpd5=11
iqpd5=51
izpd5=7
ifmtngrb=0
kdimq=27
ifcubic=0
stdprs="1000.,975.,950.,925.,900.,875.,850.,825.,800.,775.,750.,700.,650.,600.,550.,500.,450.,400.,350.,300.,250.,225.,200.,175.,150.,125.,100.,70.,50.,30.,20.,10.,7.,5.,3.,2.,1."
fnmtngrb=$ofile
#
@RUNSCR_DIR@/p2sig $ofile sigit \
					${SDATE}00 $ifmoisrh $ifheight \
					$iupd5:$ivpd5:$itpd5:$iqpd5:$izpd5:$ifmtngrb:$kdimq:$ifcubic $stdprs \
					sfctmp $fnmtngrb || exit 8
