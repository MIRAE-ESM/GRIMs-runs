#!/bin/sh
set -x
#
# make sigit/sigit_add
#
if [ $# -lt 1 ] ; then
	echo $0:  argument error
	exit 8
fi
#
# Change resolution
#
# $1 is input sigma file
# $2 is output sigma file
#
inputfile=$1
if [ $# -eq 2 ]; then
	anal=$2
else
	anal='ncep'
fi
#
lrep='.TRUE.'
ltrn='.TRUE.'
lnew='.TRUE.'
#
PROG=chgr
#
if [ @SYSTEM@ = x1e ] ; then
	FILENV=filenv.$$
	export FILENV
	assign -R
elif [ @SYSTEM@ = cray -o @SYSTEM@ = t90 -o @SYSTEM@ = t3e ] ; then
	assign -R
fi
#
cat >${PROG}.parm <<EOF
&NAMCHGR
LTRN=$ltrn
LNEW=$lnew
LREP=$lrep
ANAL='$anal'
FNAME='$inputfile'
SDATE=$SDATE,
/
EOF
#
if [ @SYSTEM@ = dec ];then
   ulimit -s 1024000
elif [ @SYSTEM@ = mac_gnu ]; then
   ulimit -s hard
else
   ulimit -s unlimited
   ulimit -v unlimited
fi
#
rm -f $PROG.x
ln -s @BIN_DIR@/${PROG}.x $PROG.x
@RUNENV@ ./$PROG.x 1>$PROG.out 2>&1  ||  exit 8
rm -f $PROG.x
# 
exit 0
