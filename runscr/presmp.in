#!/bin/sh
set -x
#
#  Pre-proccess for smp 
#
#  $1 is starting date
#  $2 is ending date
#  $3 is initial date
#  $4 is the number of time
#  $5 is dtv
#
STIME=${STIME:=$1}
ETIME=${ETIME:=$2}
#
PROG=presmp
cat >$PROG.parm <<EOF
&namtime
stime=$STIME,
etime=$ETIME,
/
EOF
#
#
#  Execute forecast
#
if [ @SYSTEM@ = x1e ] ; then
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi

if [ @SYSTEM@ = cray -o @SYSTEM@ = t90 -o @SYSTEM@ = t3e ] ; then
        assign -R
fi
@FTASS@ orogrd.smth                @FTNID@24
@FTASS@ @CON_DIR@/aerosol.macc.asc @FTNID@47
@FTASS@ @CON_DIR@/ozone_gmao.asc   @FTNID@48
@FTASS@ @CON_DIR@/co2_gosat.asc    @FTNID@49
rm -f $PROG.x
ln -s @BIN_DIR@/${PROG}.x $PROG.x
./$PROG.x < $PROG.parm 1>$PROG.out 2>&1
if [ $? -ne 0 ] ; then
	echo "`date` $0: Execution failed." >>ERROR.out
	exit 8
fi
rm -f @FTNID@[0-9]*
exit 0
