#!/bin/sh
#set -ax
#-------------------------------------------------------------------------------
#
# abstract: make namelist for paralist and inputfile
#
# history:
#   2015-01-01 myung-seo koo   paralist  (refer to paramodel.F90)
#   2020-04-09 myung-seo koo   inputfile (refer to iofile.F90)
#
#-------------------------------------------------------------------------------
EXECDIR=${EXECDIR:=$1}
#
namfile="$EXECDIR/namelist.grims"
#
# input files
#
mtnres=2
#mtnavg="@CON_DIR@/top${mtnres}m_avg.20i4.asc"
#mtnvar="@CON_DIR@/top${mtnres}m_var.20i4.asc"
#mtnmax="@CON_DIR@/top${mtnres}m_max.20i4.asc"
#mtnslm="@CON_DIR@/top${mtnres}m_slm.80i1.asc"
mtnavg="@CON_DIR@/top${mtnres}m_avg.bin"
mtnvar="@CON_DIR@/top${mtnres}m_var.bin"
mtnmax="@CON_DIR@/top${mtnres}m_max.bin"
mtnslm="@CON_DIR@/top${mtnres}m_slm.bin"
#mtnvar4="@CON_DIR@/top8m_var.20i4.asc"
mtnvar4="@CON_DIR@/top8m_var.bin"
rivermap="@CON_DIR@/flwdirGSWP2.hlf.asc"
bc="@CON_DIR@/MACC.nc"
dust="@CON_DIR@/MACC.nc"
oc="@CON_DIR@/MACC.nc"
seasalt="@CON_DIR@/MACC.nc"
so4="@CON_DIR@/MACC.nc"
ozone="@CON_DIR@/ozone_cams.nc"
co2="@CON_DIR@/co2_gosat.nc"
lwdata="@CON_DIR@/RRTMG_LW_DATA_DBL"
swdata="@CON_DIR@/RRTMG_SW_DATA_DBL"
#
# make paralist
#
echo "&paralist" > $namfile
	echo "lowclim_= @LOWCLIM@," >> $namfile
	echo "tprof_  = @TPROF@" >> $namfile
if [ @MODEL@ = smp ]; then
	echo "smpobs_ = '$obs_smp'" >> $namfile
	echo "levs_   = $levs" >> $namfile
else
	echo "ncpus_  = @NCPUS@" >> $namfile
	echo "jcap_   = @JCAP@" >> $namfile
	echo "levs_   = @LEVS@" >> $namfile
	echo "io_     = @POST_IGRD@" >> $namfile
	echo "jo_     = @POST_JGRD@" >> $namfile
	echo "ko_     = @POST_LAYER@" >> $namfile
	if [ @MODEL@ = rmp -o  @MODEL@ = rop ] ; then
	echo "irelx_  = @IRELX@" >> $namfile
	echo "igrd_   = @IGRD@" >> $namfile
	echo "jgrd_   = @JGRD@" >> $namfile
	if [ @CIGRD1@ != 1 -a @CJGRD1@ != 1 ] ; then
	echo "cigrd1_ = @CIGRD1@" >> $namfile
	echo "cjgrd1_ = @CJGRD1@" >> $namfile
	fi
	fi
	if [ @MARCH@ = mpi -o @MARCH@ = hybrid ] ; then
	if [ @MODEL@ = rop ] ; then
	echo "npes_   = @RMP_NPES@" >> $namfile
	else
	echo "npes_   = @NPES@" >> $namfile
	fi
	echo "ncol_   = @NCOL@" >> $namfile
	fi
fi
echo "/" >> $namfile
echo "" >> $namfile
#
# make paralist
#
echo "&inputfile" >> $namfile
echo "mtnavg(1)='$mtnavg',mtnavg(2)='unformatted'" >> $namfile
echo "mtnvar(1)='$mtnvar',mtnvar(2)='unformatted'" >> $namfile
echo "mtnmax(1)='$mtnmax',mtnmax(2)='unformatted'" >> $namfile
echo "mtnslm(1)='$mtnslm',mtnslm(2)='unformatted'" >> $namfile
echo "mtnvar4(1)='$mtnvar4',mtnvar4(2)='unformatted'" >> $namfile
echo "rivermap(1)='$rivermap',rivermap(2)='formatted'" >> $namfile
echo "bc(1)='$bc',bc(2)='BC'" >> $namfile
echo "dust(1)='$dust',dust(2)='DUST'" >> $namfile
echo "oc(1)='$oc',oc(2)='OC'" >> $namfile
echo "seasalt(1)='$seasalt',seasalt(2)='SEASALT'" >> $namfile
echo "so4(1)='$so4',so4(2)='SO4'" >> $namfile
echo "ozone(1)='$ozone',ozone(2)='ozone'" >> $namfile
echo "co2(1)='$co2',co2(2)='co2'" >> $namfile
echo "swdata(1)='$swdata',swdata(2)='unformatted'" >> $namfile
echo "lwdata(1)='$lwdata',lwdata(2)='unformatted'" >> $namfile
echo "/" >> $namfile
