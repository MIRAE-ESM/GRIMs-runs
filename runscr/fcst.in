#!/bin/bash
#------------------------------------------------------------------end_of_header
set -ax
#
if [ @SYSTEM@ = linux_pgi ]; then
export NO_STOP_MESSAGE=1
fi
#export MPIEXEC_TIMEOUT=15   # to prevent qdel error
#
#  execute forecast.
#
#  $1 ... FCSTENV required for mpi runs on origin (this should be the
#         last argument since it can be blank.
#         Note that script referrs $1 as $* since it is a string of
#         characters separated by blanks so that it takes all the arguments
#         as one.
#
if [ "$EXECDIR" != "" ]; then
	cd $EXECDIR
fi
#
PROG=fcst
#
# SWRMDC
#
if [ "@SWRMDC@" = "yes" ]; then
	mon=01
	while [ $mon -le 12 ]; do
		@FTASS@ @CON_DIR@/global_aeropac3a.m${mon}.txt .
		mon=`expr $mon + 1`
		if [ $mon -lt 10 ]; then
			mon=0$mon
		fi
	done
fi

#
#  Execute forecast
#
if [ @SYSTEM@ = x1e ] ; then
	FILENV=filenv.$$
	export FILENV
	assign -R
elif [ @SYSTEM@ = cray -o @SYSTEM@ = t90 -o @SYSTEM@ = t3e ] ; then
	assign -R
fi
#
# forecast hour
#
fh=`@ETC_DIR@/fhour sigit`
#
rm -f $PROG.x
if [ ! -s @BIN_DIR@/fcst.x ] ; then
	echo @BIN_DIR@/fcst.x does not exist
	exit 8
fi
@FTASS@ @BIN_DIR@/fcst.x $PROG.x  ||  exit 8
if [ @SYSTEM@ = dec ] ; then
	datasize=1048576
	stacksize=3276800
	vmemsize=unlimited
elif [ @SYSTEM@ = mac_gnu ] ; then
	datasize=unlimited
	stacksize=hard
	vmemsize=unlimited
else
	datasize=unlimited
	stacksize=unlimited
	vmemsize=unlimited
fi
ulimit -c $datasize
ulimit -s $stacksize
ulimit -v $vmemsize
here_dir=`pwd`
if [ @HOST_NAME@ = compas_linux -a @MARCH@ != single -a @MARCH@ != thread ] ; then
    sed -n "1,@FCST_NPES@p" $HOME/node_list >$here_dir/hostfile
    sed 's/^/ssh /g' $here_dir/hostfile | sed 's/$/ "date"/g' >force_mount.sh
    chmod a+x force_mount.sh
    ./force_mount.sh
    /opt/mpich/myrinet/pgi/bin/mpirun -nolocal -np @FCST_NPES@ -machinefile $here_dir/hostfile $here_dir/$PROG.x 1>$here_dir/${PROG}out.ft$hx 2>&1
else
   @FCSTENV@ ./$PROG.x 1>fcstout.ft$fh 2>&1
fi
#
stat=$?
if [ $stat -ne 0 ] ; then
	echo "`date` $0: Execution failed." >>ERROR.out
	exit 8
fi
grep 'NaN' fcstout.ft$fh
if [ $? -eq 0 ]; then
	echo "The run has NaN crushed !!!" >> ERROR.out
	exit 8
fi
grep ' nan ' fcstout.ft$fh
if [ $? -eq 0 ]; then
	echo "The run has nan crushed !!!" >> ERROR.out
	exit 8
fi
grep '<WARNING>:' fcstout.ft$fh >>ERROR.out
rm -f filenv.$$ >/dev/null
if [ @SYSTEM@ = x1e ]; then
	rm -f $FILENV
fi
#
echo "`date` $0: fcst is completely ended"
exit 0
