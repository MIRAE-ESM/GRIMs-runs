      program map
      call opngks
c
      proj= _proj
      true= _truth
      glatc=_cenlat
      glonc=_cenlon
      rot=_orient
      delx=_delx 
      dely=_dely 
      im=_igrd1   
      jm=_jgrd1   
      ileft=_leftgrd
      jbotm=_botmgrd
      call pltgrd(proj,true,glatc,glonc,rot,delx,dely,im,jm,ileft,jbotm)
c
      call clsgks
      stop
      end
        subroutine pltgrd(proj,true,glatc,glonc,rot,dx,dy,
     1                    im,jm,ileft,jbotm)
      parameter(istat=327,iconran=1)
      dimension flat(_igrd1,_jgrd1),flon(_igrd1,_jgrd1)
      dimension rlat(istat),rlon(istat),data(im,jm)
      dimension wk(13*im*jm),iwk(27*im*jm+im*jm*im*jm),scrarr(10000)
      character*3 ch
      character*40 head
c
      hfpi = dasin(1.0d0)
      pi = 2.0 * hfpi
      twopi = 2.0 * pi
      rad = pi / 180.
c
      QTPI = HFPI * 0.5
      RAD = PI / 180.
      DELX = dx
      DELY = dy
C
C --------- SETUP REGIONAL LAT/LON AND MAP FACTOR -----
C
C IF PROJ=0  DO MERCATER PROJECTION
C IF PROJ=1  DO NORTH POLAR PROJECTION
C IF PROJ=-1 DO SOUTH POLAR PROJECTION
C
      NPROJ = PROJ
C
      IF( NPROJ.EQ.1 .OR. NPROJ.EQ.-1 ) THEN
C ++++++++++++++++++++++++++++++++++++++
C POLAR PROJECTION
C ++++++++++++++++++++++++++++++++++++++
      TRUTH  = true * RAD
      TRUTH  = NPROJ * TRUTH
      ORIENT  = rot * RAD
      DLAMDA0 = ORIENT + HFPI
      A2 =  6371200.0 * ( 1.0 + SIN(TRUTH) )
      RADLAT = glatc * RAD
      RADLON = glonc * RAD - DLAMDA0
      RADLAT = NPROJ * RADLAT
      RADLON = NPROJ * RADLON
      YYY = A2 * COS( RADLAT )/(1. + SIN( RADLAT ) )
      CENLAT = glatc
      IF( ABS(CENLAT) .EQ. 90. ) THEN YYY = 0.0
      Y00 = YYY * SIN( RADLON ) - ( jbotm -1.) * DELY
      X00 = YYY * COS( RADLON ) - ( ileft -1.) * DELX
      PRINT *,' DELX X00 Y00 ',DELX,X00,Y00
C
C =========
C           LAT LOOP
      DO 100 J = 1,jm
      LATS = J
      YS = Y00 + (LATS-1)*DELY
C
      DO 100 I=1,im
      X = X00 + (I-1)*DELX
      IF( X .GT. 0. ) THEN
         FLONS = ATAN(YS/X)
      ELSE IF ( X .LT. 0. ) THEN
         FLONS = PI + ATAN(YS/X)
      ELSE
         FLONS = HFPI
         IF( YS .LT. 0. ) FLONS = FLONS * 3.0
      ENDIF
      FLONS = FLONS + DLAMDA0
      FLONS = AMOD(FLONS,TWOPI)
      FLONS = NPROJ * FLONS 
      IF(FLONS.LT.0. ) FLONS = TWOPI + FLONS
C
      RSOA2 = SQRT( X*X + YS*YS )/A2
      FLATS = HFPI - 2.0 * ATAN(RSOA2)
      FLAT(I,J) = NPROJ * FLATS
      FLON(I,J) = FLONS
C
 100  CONTINUE
C
      ELSE IF ( NPROJ.EQ.0 ) THEN
C
C ++++++++++++++++++++++++++++
C DO MERCATER
C ++++++++++++++++++++++++++++
      TRUTH  = true * RAD
      CENLAT = glatc * RAD
      CENLON = glonc * RAD 
      A2 =  6371200.0 * COS( TRUTH ) 
      X0 = 0.0
      Y0 = A2 * LOG( ABS( TAN( QTPI + 0.5 * CENLAT ) ) )
      X00 = - ( ileft - 1.0 ) * DELX
      Y00 = - ( jbotm - 1.0 ) * DELY
      DLAMDA0 = 0.0
C
      DO 200 J = 1,jm
      LATS = J
      YS = Y00 + (LATS-1)*DELY + Y0
C
       DO 200 I=1,im
         X = X00 + (I-1)*DELX + X0
         FLONS = X / A2 + CENLON
         FLONS = AMOD(FLONS,TWOPI)
         IF(FLONS.LT.0. ) FLONS = TWOPI + FLONS
C
         FLATS = 2.0 *( ATAN( EXP( YS/A2 ) ) - QTPI )
         FLAT(I,J) = FLATS
         FLON(I,J) = FLONS
C
C
 200  CONTINUE
C
      ENDIF
C
c
      flat00= flat(1,1) / rad
      flat01= flat(1,jm) / rad
      flat10= flat(im,1) / rad
      flat11= flat(im,jm) / rad
      flon00= flon(1,1) / rad
      flon01= flon(1,jm) / rad
      flon10= flon(im,1) / rad
      flon11= flon(im,jm) / rad
      print *,' flat00 flon00 ',flat00,flon00
      print *,' flat01 flon01 ',flat01,flon01
      print *,' flat10 flon10 ',flat10,flon10
      print *,' flat11 flon11 ',flat11,flon11
      cntr = dlamda0/rad - 90.0
      if( cntr.lt.-180.0 ) cntr = cntr + 360.0
      call setusv('LW',1200)
c
c
      nprojj = int(proj)
      cjbotm = float(jbotm)
      cileft = float(ileft)
      fflat0 = flat00*rad
      fflat1 = flat11*rad
      fflon0 = flon00*rad
      fflon1 = flon11*rad
      call ll2xy(fflat1,fflon1,x11,y11
     1            ,nprojj,true,glatc,glonc,rot,cjbotm,cileft,dx,dy)
      call ll2xy(fflat0,fflon0,x00,y00
     1            ,nprojj,true,glatc,glonc,rot,cjbotm,cileft,dx,dy)
      print *,'x11y11 ',flat11,flon11,x11,y11
     1            ,proj,true,glatc,glonc,rot,jbotm,ileft,dx,dy
      ddx = x11 - x00
      ddy = y11 - y00
       print *,'x00 y00 x11 y11 ddx ddy ',x00,y00,x11,y11,ddx,ddy
c
c      open(unit=71,file='/dm/wd20sh/korea/exec/mtn.oss',
c     1       status='old',form='formatted')
c       assign -a ***.oss -Fcos -Nibm fort.71
c        
      read(71) data
c
c
c
      call opngks
      do np = 1,1
      if( nproj.eq.0 ) then
      call supmap(9,0.,0.,0.,flat00,flon00,flat11,flon11,2,
     1            -1,1,0,ierr)
      else
      call supmap(1,90.,cntr,0.,flat00,flon00,flat11,flon11,2,
c    1            -1,1,0,ierr) !!! for 1 degree interval
     1            10,1,0,ierr) !!! for 1 degree interval
      endif
      call getset(dl,dr,db,dt,ul,ur,ub,ut,1)
      fim=im
      fjm=jm
      call    set(dl,dr,db,dt,1.,fim,1.,fjm,1)
      im1=im-1
      jm1=jm-1
      call perim(1,im1,1,jm1)
c
      if(iconran.eq.1) then
      call getset(dl,dr,db,dt,ul,ur,ub,ut,1)
      fim=im
      fjm=jm
      call    set(dl,dr,db,dt,1.,fim,1.,fjm,1)
      im1=im-1
      jm1=jm-1
c
        CALL CONOP3('CHL=ON',ARRAY,2)
        CALL CONOP3('CIL=ON',2.,1)
        CALL CONOP1('LAB=OFF')
        CALL CONOP1('PDV=ON')
        CALL CONOP1('SCA=OFF')
c
      head = 'Terrain height(m) used in the RSM'
      ymax = float(jm)
      xmax = float(im)
      LCH = LEN(head)
      YMAXP=YMAX+YMAX/50.
      XHALF=(XMAX+1.)/2.
      CALL PWRITX(XHALF,YMAXP,head,LCH,14,0,0)
c
      if(np.eq.1) call conrec(data,im,im,jm,100.,9000.,200.,1,0,1)
c
      endif
      call frame
      enddo
c
      return
      end
      SUBROUTINE LL2XY(BLAT,BLON,X,Y,nproj,ctruth,ccenlat,
     1     ccenlon,corient,
     1cbtmgrd,clftgrd,cdelx,cdely)
C
C     PRINT 1234
C1234 FORMAT(' ==== IN ROUTINE LL2XY === ')
C
      PARAMETER(PI=3.14159,TWOPI=2.0*PI,HFPI=0.5*PI,QTPI=0.5*HFPI)
      PARAMETER(RAD=PI/180.,rerth=6371000.)
C
C --------- SETUP REGIONAL LAT/LON AND MAP FACTOR -----
C
C IF PROJ=0  DO MERCATER PROJECTION
C IF PROJ=1  DO NORTH POLAR PROJECTION
C IF PROJ=-1 DO SOUTH POLAR PROJECTION
C
C
      IF( NPROJ.EQ.1 .OR. NPROJ.EQ.-1 ) THEN
C ++++++++++++++++++++++++++++++++++++++
C POLAR PROJECTION
C ++++++++++++++++++++++++++++++++++++++
        TRUTH  = CTRUTH * RAD
        TRUTH  = NPROJ * TRUTH
        ORIENT  = CORIENT * RAD
        DLAMDA0 = ORIENT + HFPI
        A2 =  RERTH * ( 1.0 + SIN(TRUTH) )
        RADLAT = CCENLAT * RAD
        RADLON = CCENLON * RAD - DLAMDA0
        RADLAT = NPROJ * RADLAT
        RADLON = NPROJ * RADLON
        YYY = A2 * COS( RADLAT )/(1. + SIN( RADLAT ) )
        CENLAT = CCENLAT
        IF( ABS(CENLAT) .EQ. 90. ) THEN YYY = 0.0
        Y00 = YYY * SIN( RADLON ) - ( CBTMGRD -1.) * CDELY
        X00 = YYY * COS( RADLON ) - ( CLFTGRD -1.) * CDELX
C
C =========
        RSOA2 = TAN( (HFPI-BLAT*NPROJ)*0.5 )
        X2PY2 = ( RSOA2 * A2 ) ** 2.0
        RLON = NPROJ * (BLON - DLAMDA0)
        RLON = AMOD(RLON,TWOPI)
        IF( RLON.LT.0. ) RLON=TWOPI+RLON
        YOX = TAN(RLON)
        X = SQRT( X2PY2/(1.+YOX*YOX) )
        Y = SQRT( X2PY2 - X*X )
        IF( RLON.GT.HFPI .AND. RLON.LT. PI+HFPI ) X = -X
        IF( RLON.GT.PI .AND. RLON.LT. TWOPI ) Y = -Y
C
      ELSE IF ( NPROJ.EQ.0 ) THEN
C
C ++++++++++++++++++++++++++++
C DO MERCATER
C ++++++++++++++++++++++++++++
        TRUTH  = CTRUTH * RAD
        CENLAT = CCENLAT * RAD
        CENLON = CCENLON * RAD 
        A2 =  RERTH * COS( TRUTH ) 
        X0 = 0.0
        Y0 = A2 * LOG( ABS( TAN( QTPI + 0.5 * CENLAT ) ) )
        X00 = - ( CLFTGRD - 1.0 ) * CDELX
        Y00 = - ( CBTMGRD - 1.0 ) * CDELY
        DLAMDA0 = 0.0
C
        BLON = MOD(BLON,TWOPI)
        IF(BLON.LT.0.) BLON = TWOPI + BLON
        X=A2*(BLON-CENLON)
        Y=A2*LOG(TAN(BLAT/2.0+QTPI))
C
      ENDIF
C
      RETURN
      END
